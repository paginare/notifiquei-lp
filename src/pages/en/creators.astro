---
/** /en/creators no visual novo (30/09/2026). Corpo em components/PaginaCriadoresIntl.astro. */
import Base from "../../layouts/Base.astro";
import PaginaCriadoresIntl from "../../components/PaginaCriadoresIntl.astro";
import { criadores } from "../../i18n/paginas-intl";
import "../../styles/home.css";

const c = criadores.en;
const url = "https://notifiquei.com.br/en/creators";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: c.title, url, isPartOf: { "@id": "https://notifiquei.com.br/#org" } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.itens.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={c.title} description={c.description} path="/en/creators" lang="en" jsonLd={jsonLd} heroPoster="/assets/creators/criadora-sofa.webp">
  <PaginaCriadoresIntl lang="en" />
</Base>
