---
/**
 * Home em inglês. Mesmo corpo da versão em português (HomeBody):
 * só a copy muda. Mercado internacional por definição — a Pages Function
 * estampa data-market="INTL", e o CSS esconde o que é do Brasil (preço em
 * real e plano grátis) e mostra os planos do Stripe.
 */
import Base from "../../layouts/Base.astro";
import HomeBody from "../../components/HomeBody.astro";
import { copyHome } from "../../i18n/home";
import "../../styles/home.css";

const t = copyHome("en");
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path="/en"
  hreflangOf="/"
  lang="en"
>
  <HomeBody lang="en" />
</Base>
