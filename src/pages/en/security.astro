---
/** /en/security — segurança e privacidade (30/09/2026). Corpo em components/PaginaSegurancaIntl.astro. */
import Base from "../../layouts/Base.astro";
import PaginaSegurancaIntl from "../../components/PaginaSegurancaIntl.astro";
import { segurancaIntl } from "../../i18n/seguranca-intl";
import "../../styles/home.css";

const c = segurancaIntl.en;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: c.title, url: "https://notifiquei.com.br/en/security", isPartOf: { "@id": "https://notifiquei.com.br/#org" } },
];
---
<Base title={c.title} description={c.description} path="/en/security" lang="en" jsonLd={jsonLd}>
  <PaginaSegurancaIntl lang="en" />
</Base>
