---
/** Home em português. O corpo é o mesmo das versões /en e /es (HomeBody). */
import Base from "../layouts/Base.astro";
import HomeBody from "../components/HomeBody.astro";
import { jsonLd } from "../data/home";
import { copyHome } from "../i18n/home";
import "../styles/home.css";

const t = copyHome("pt-BR");
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path="/"
  hreflangOf="/"
  jsonLd={jsonLd}
  heroPoster="/assets/home/creator-hero-v4.webp"
  heroPosterSrcset="/assets/home/creator-hero-v4-760.webp 760w, /assets/home/creator-hero-v4.webp 1120w"
  heroPosterSizes="(max-width: 900px) 100vw, 50vw"
  lang="pt-BR"
>
  <HomeBody lang="pt-BR" />
</Base>
