  <script>
    // Toggle mensal/anual nos planos
    const toggle = document.getElementById("billtoggle");
    const grid = document.getElementById("plans-grid");
    if (toggle && grid) {
      toggle.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".billtoggle__opt");
        if (!btn) return;
        const annual = btn.dataset.cycle === "a";
        toggle.querySelectorAll(".billtoggle__opt").forEach((o) => o.classList.toggle("is-on", o === btn));
        // querySelectorAll, não querySelector: desde que o card virou multi-moeda,
        // cada um carrega 3 preços e 2 botões (Brasil + internacional). No singular,
        // o toggle só mexia no primeiro — o BRL, que fica escondido lá fora — e o
        // gringo via o preço travado no anual. Atualiza todos; o CSS mostra o certo.
        grid.querySelectorAll<HTMLElement>(".plan").forEach((card) => {
          card.querySelectorAll<HTMLElement>(".plan__amount").forEach((amt) => {
            amt.textContent = annual ? amt.dataset.a! : amt.dataset.m!;
          });
          card.querySelectorAll<HTMLElement>(".plan__bill").forEach((bill) => {
            bill.textContent = annual ? bill.dataset.bill! : "";
          });
          card.querySelectorAll<HTMLAnchorElement>(".plan__cta").forEach((cta) => {
            cta.href = annual ? cta.dataset.hrefA! : cta.dataset.hrefM!;
          });
        });
      });
    }

    // ===== Como funciona: demo da plataforma auto-rotativa + glow no passo ativo =====
    // (sem acoplar ao scroll — gira sozinha enquanto visível e destaca o passo correspondente)
    const como = document.getElementById("como");
    if (como) {
      const stages = Array.from(como.querySelectorAll<HTMLElement>(".cstage"));
      const dots = Array.from(como.querySelectorAll<HTMLElement>(".cdemo__rail b"));
      const stepEls = Array.from(como.querySelectorAll<HTMLElement>(".step"));
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let active = -1;
      const setStage = (i: number) => {
        if (i === active || i < 0 || i >= stages.length) return;
        active = i;
        stages.forEach((s, k) => s.classList.toggle("is-on", k === i));
        dots.forEach((d, k) => d.classList.toggle("is-on", k <= i));
        stepEls.forEach((s, k) => s.classList.toggle("is-active", k === i));
      };
      setStage(0);

      let cycle: number | undefined;
      const start = () => { if (cycle || reduce) return; cycle = window.setInterval(() => setStage((active + 1) % stages.length), 1400); };
      const stop = () => { if (cycle) { clearInterval(cycle); cycle = undefined; } };

      if ("IntersectionObserver" in window && !reduce) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
          { threshold: 0.3 }
        );
        io.observe(como);
      }
    }
  </script>

  <script is:inline>
    // PostHog event tracking
    document.addEventListener('DOMContentLoaded', function () {
      // Hero CTA
      var heroCta = document.querySelector('.hero__actions .btn--brand');
      if (heroCta) {
        heroCta.addEventListener('click', function () {
          window.posthog?.capture('hero_cta_clicked');
        });
      }

      // Mid-page CTA
      var midCta = document.querySelector('.midcta__actions .btn--brand');
      if (midCta) {
        midCta.addEventListener('click', function () {
          window.posthog?.capture('hero_cta_clicked', { section: 'mid_page' });
        });
      }

      // Final CTA (Começar grátis)
      var finalCtas = document.querySelectorAll('.finalcta__actions .btn--inverse');
      finalCtas.forEach(function (btn) {
        btn.addEventListener('click', function () {
          window.posthog?.capture('hero_cta_clicked', { section: 'final_cta' });
        });
      });

      // Plan CTAs
      var planGrid = document.getElementById('plans-grid');
      if (planGrid) {
        planGrid.addEventListener('click', function (e) {
          var cta = e.target.closest('.plan__cta');
          if (!cta) return;
          var card = cta.closest('.plan');
          var planName = card ? (card.querySelector('.plan__name') || {}).textContent : null;
          var toggle = document.getElementById('billtoggle');
          var activeBtn = toggle ? toggle.querySelector('.billtoggle__opt.is-on') : null;
          var cycle = activeBtn ? activeBtn.dataset.cycle : 'a';
          window.posthog?.capture('plan_cta_clicked', {
            plan_name: planName ? planName.trim() : null,
            billing_cycle: cycle === 'a' ? 'annual' : 'monthly',
          });
        });
      }

      // Free plan CTA (signup)
      var freeCta = document.querySelector('.freeplan__cta .btn');
      if (freeCta) {
        freeCta.addEventListener('click', function () {
          window.posthog?.capture('signup_cta_clicked', { plan_name: 'Grátis', section: 'plans' });
        });
      }

      // Affiliate section CTA
      var affilCta = document.querySelector('.affil .btn--brand');
      if (affilCta) {
        affilCta.addEventListener('click', function () {
          window.posthog?.capture('signup_cta_clicked', { section: 'affiliate' });
        });
      }
    });
  </script>

  <script is:inline>
    // Grava o idioma antes de sair pro Stripe. A URL de retorno do Payment Link
    // é fixa e não varia por idioma; o /obrigado lê este cookie (via a Pages
    // Function) pra falar com o comprador na língua dele.
    document.addEventListener('click', function (e) {
      var a = e.target && e.target.closest && e.target.closest('a[href*="buy.stripe.com"]');
      if (!a) return;
      var m = a.getAttribute('href').match(/nqlang_([a-zA-Z-]+)/);
      if (m) document.cookie = 'nq_lang=' + m[1] + '; path=/; max-age=3600; SameSite=Lax';
    }, true);
  </script>
