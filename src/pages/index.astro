---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/HomeIcon.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeAuthority from "../components/HomeAuthority.astro";
import HomeDemo from "../components/HomeDemo.astro";
import HomeMcp from "../components/HomeMcp.astro";
import HomePricing from "../components/HomePricing.astro";
import LangBanner from "../components/LangBanner.astro";
import { FREE, WPP, faqs, clientes, logoDims, jsonLd } from "../data/home";
import "../styles/home.css";

const navigation = [
  { href: "/#plataforma", label: "Recursos" },
  { href: "/#como", label: "Como funciona" },
  { href: "/criadores", label: "Para criadores" },
  { href: "/#planos", label: "Planos" },
];
const audiences = [
  { tag: "CRIADORES", title: "Seu conteúdo abre portas. E conversas.", body: "Entregue seu material, divulgue seu curso e aproxime quem acompanha você.", image: "/assets/home/creator-content-v2.webp", alt: "Criador gravando conteúdo com o celular em seu espaço de trabalho", theme: "pink", trigger: "direct" },
  { tag: "LOJAS E NEGÓCIOS", title: "Do “tem meu tamanho?” ao seu carrinho.", body: "Responda o interesse na hora e leve o cliente até o produto que ele quer.", image: "/assets/home/creator-fashion-v2.webp", alt: "Criadora de moda apresentando uma camisa rosa e calça clara", theme: "cream", trigger: "comment" },
  { tag: "AFILIADOS", title: "Você indica. Seu link chega junto.", body: "Transforme a curiosidade no seu post em um clique no seu link de afiliado.", image: "/assets/home/creator-business-v2.webp", alt: "Afiliada gravando uma recomendação de produto com o celular", theme: "dark", trigger: "story" },
];
const steps = [
  { n: "01", icon: "instagram", title: "Conecte sua conta", body: "Entre com seu Instagram pelo login oficial da Meta. Sua senha continua só com você." },
  { n: "02", icon: "chat", title: "Faça do seu jeito", body: "Escolha um post, a palavra-chave e a mensagem. Ou comece com um template pronto." },
  { n: "03", icon: "bolt", title: "Pronto. Pode publicar.", body: "Seu público comenta, o Notifiquei responde. E você acompanha tudo pelo painel." },
];
const resources = [
  { icon: "chart", title: "Entenda cada clique", text: "Veja quais automações estão levando seu público até a sua oferta." },
  { icon: "link", title: "Mude o link uma vez só", text: "Atualize o destino e todas as suas automações passam a enviar o link certo." },
  { icon: "spark", title: "Sorteie sem planilha", text: "Reúna quem comentou a palavra-chave e faça o sorteio direto no painel." },
];
---

<Base
  title="Notifiquei — Seu próximo cliente está no direct."
  description="Transforme comentários em conversas que vendem. Automatize comentários, directs e stories do Instagram com o seu jeito de falar. Conheça o Notifiquei e comece grátis."
  path="/"
  hreflangOf="/"
  jsonLd={jsonLd}
  heroPoster="/assets/home/creator-hero-v2.webp"
>
  <div class="home-page">
    <a href="#conteudo" class="home-skip">Pular para o conteúdo</a>
    <Nav links={navigation} lang="pt-BR" langLabel="Escolher idioma" comecar="Começar agora" />
    <main id="conteudo">
      <HomeHero />
      <div class="home-language-suggestions">
        <div data-suggest-only="en"><LangBanner texto="View this page in English" href="/en" /></div>
        <div data-suggest-only="es"><LangBanner texto="Ver esta página en español" href="/es" /></div>
      </div>

      <HomeAuthority />

      <section class="home-proof" aria-label="Marcas que usam o Notifiquei">
        <div class="container">
          <p>Mais conversas na rotina de marcas como</p>
          <div class="home-proof__logos">
            {clientes.map((file) => (
              <img src={`/assets/clientes/${file}`} alt={file.replace(/\.(png|svg)$/, "").replace(/-/g, " ")} width={logoDims[file]} height="30" loading="lazy" />
            ))}
          </div>
        </div>
      </section>

      <section class="home-section home-audiences">
        <div class="container">
          <div class="home-centered-heading">
            <span class="home-kicker"><Icon name="heart" size={17} /> FEITO PARA QUEM TEM ALGO A COMPARTILHAR</span>
            <h2>Tem gente querendo<br /><span class="hl">o que você tem.</span></h2>
            <p>Seu próximo cliente, aluno ou fã pode estar a uma mensagem de distância.</p>
          </div>
          <div class="home-audience-grid">
            {audiences.map((audience) => (
              <article class={`audience-card audience-card--${audience.theme}`}>
                <div class="audience-card__photo">
                  <img src={audience.image} alt={audience.alt} width="480" height="600" loading="lazy" />
                  <span>{audience.tag}</span>
                </div>
                <div class="audience-card__copy">
                  <h3>{audience.title}</h3>
                  <p>{audience.body}</p>
                  <a href="#plataforma" data-show-demo={audience.trigger}>Veja como funciona <Icon name="diagonal" size={20} /></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <HomeDemo />

      <HomeMcp />

      <section class="home-section home-before-after">
        <div class="container">
          <div class="home-centered-heading">
            <span class="home-kicker">MENOS COPIAR E COLAR. MAIS TEMPO PARA VOCÊ.</span>
            <h2>Seu direct pode<br />ter <span class="hl">outra rotina.</span></h2>
          </div>
          <div class="home-comparison">
            <article class="home-comparison__before">
              <span class="home-comparison__label">SEM AUTOMAÇÃO</span>
              <h3>Seu post bombou.<br />Seu trabalho também.</h3>
              <div class="waiting-messages" aria-label="Exemplos de perguntas repetidas">
                <span>Tem o link? <span>👀</span></span>
                <span>Qual o valor? <span>💬</span></span>
                <span>Me manda também! <span>🙋</span></span>
              </div>
              <ul>
                <li><Icon name="minus" size={18} /> Responder a mesma pergunta, de novo.</li>
                <li><Icon name="minus" size={18} /> Parar o que está fazendo a cada direct.</li>
                <li><Icon name="minus" size={18} /> Deixar quem tem interesse esperando.</li>
              </ul>
            </article>
            <article class="home-comparison__after">
              <span class="home-comparison__label"><img src="/assets/favicon.svg" alt="" width="25" height="25" /> COM NOTIFIQUEI</span>
              <h3>Seu post bombou.<br /><span>Pode comemorar.</span></h3>
              <div class="answered-message"><span><Icon name="check" size={22} /></span><div><b>Link enviado no direct.</b><small>Mais uma conversa acontecendo.</small></div><Icon name="spark" size={25} /></div>
              <ul>
                <li><Icon name="check" size={18} /> Respostas automáticas com a sua voz.</li>
                <li><Icon name="check" size={18} /> Links chegando a quem quer saber mais.</li>
                <li><Icon name="check" size={18} /> Seu tempo de volta para criar e vender.</li>
              </ul>
              <a href={FREE} class="home-text-link br-only" data-home-cta="mid_page">Quero essa rotina <Icon name="arrow" size={19} /></a>
              <a href="#planos" class="home-text-link intl-only" data-home-cta="mid_page">Quero essa rotina <Icon name="arrow" size={19} /></a>
            </article>
          </div>
        </div>
      </section>

      <section class="home-section home-affiliate" id="afiliados">
        <div class="container">
          <div class="home-affiliate__grid">
            <div class="home-affiliate__copy">
              <span class="home-kicker"><Icon name="link" size={17} /> PARA QUEM GANHA INDICANDO</span>
              <h2>“Comenta <span class="hl">QUERO</span><br />que eu te mando.”<br />E pronto.</h2>
              <p>Você posta o achadinho. O Notifiquei entrega o seu link de afiliado no direct de cada pessoa que comentou. Sem passar o dia copiando e colando.</p>
              <a href={FREE} class="btn btn--brand btn--lg br-only" data-home-cta="affiliate">Quero automatizar meus links <Icon name="arrow" size={20} /></a>
              <a href="#planos" class="btn btn--brand btn--lg intl-only" data-home-cta="affiliate">Quero automatizar meus links <Icon name="arrow" size={20} /></a>
            </div>
            <div class="affiliate-visual" aria-label="Exemplo de envio de link de afiliado">
              <div class="affiliate-visual__tag"><Icon name="bolt" size={18} /> Do comentário para o seu link</div>
              <div class="affiliate-request"><span>💬</span><div><small>COMENTÁRIO RECEBIDO</small><b>Quero esse achadinho! 😍</b></div></div>
              <div class="affiliate-path" aria-hidden="true"><span></span><Icon name="arrow" size={22} /></div>
              <div class="affiliate-reply"><div><img src="/assets/favicon.svg" alt="" width="35" height="35" /><span><b>Oii! Seu link chegou 💕</b><small>Enviado automaticamente no direct</small></span></div><span class="affiliate-reply__link"><Icon name="link" size={20} /> Ver meu achadinho <Icon name="diagonal" size={20} /></span></div>
              <p>Seu conteúdo. Seu link. Sua comissão.</p>
            </div>
          </div>
          <div class="home-marketplaces">
            <p>Funciona com os seus links de</p>
            <div>
              <img src="/assets/marketplaces/shopee.svg" alt="Shopee" width="1000" height="320" loading="lazy" />
              <img src="/assets/marketplaces/amazon.svg" alt="Amazon" width="603" height="182" loading="lazy" />
              <img src="/assets/marketplaces/mercadolivre.svg" alt="Mercado Livre" width="948" height="373" loading="lazy" />
              <img src="/assets/marketplaces/aliexpress.svg" alt="AliExpress" width="1719" height="372" loading="lazy" />
              <img src="/assets/marketplaces/magalu.svg" alt="Magalu" width="490" height="140" loading="lazy" />
            </div>
          </div>
        </div>
      </section>

      <section class="home-section home-extras">
        <div class="container">
          <div class="home-section-heading"><h2>A conversa é só<br /><span class="hl">o começo.</span></h2><p>As ferramentas para organizar o que acontece depois também estão aqui.</p></div>
          <div class="home-resource-list">
            {resources.map((resource) => (
              <article><span><Icon name={resource.icon} size={26} /></span><h3>{resource.title}</h3><p>{resource.text}</p></article>
            ))}
          </div>
          <div class="home-ai" id="claude">
            <span class="home-ai__icon"><Icon name="spark" size={29} /></span>
            <div><span class="home-kicker">PREFERE CONVERSAR COM A IA?</span><h3>Peça sua próxima automação ao Claude.</h3><p>O painel tem um kit pronto para você criar e gerenciar automações pela conversa.</p></div>
            <a href={FREE} class="home-text-link br-only">Conhecer a plataforma <Icon name="diagonal" size={20} /></a>
            <a href="#planos" class="home-text-link intl-only">Conhecer os planos <Icon name="diagonal" size={20} /></a>
          </div>
        </div>
      </section>

      <section class="home-section home-how" id="como">
        <div class="container">
          <div class="home-centered-heading">
            <span class="home-section-symbol"><Icon name="bolt" size={29} /></span>
            <h2>Você não precisa de código.<br /><span class="hl">Só de uma boa conversa.</span></h2>
            <p>Três passos entre a sua ideia e a primeira resposta automática.</p>
          </div>
          <ol class="home-steps">
            {steps.map((step) => (
              <li><div class="home-step__top"><span>{step.n}</span><Icon name={step.icon} size={28} /></div><h3>{step.title}</h3><p>{step.body}</p></li>
            ))}
          </ol>
          <div class="home-how__actions">
            <a href={FREE} class="btn btn--brand btn--lg br-only" data-home-cta="steps">Começar grátis <Icon name="arrow" size={20} /></a>
            <a href="#planos" class="btn btn--brand btn--lg intl-only" data-home-cta="steps">Começar agora <Icon name="arrow" size={20} /></a>
            <span><Icon name="shield" size={18} /> Conexão oficial com a Meta. Sua senha fica com você.</span>
          </div>
        </div>
      </section>

      <HomePricing />

      <section class="home-section home-faq" id="faq">
        <div class="container home-faq__grid">
          <div class="home-faq__intro">
            <span class="home-kicker">PODE PERGUNTAR</span>
            <h2>Vamos tirar<br /><span class="hl">suas dúvidas?</span></h2>
            <p>Se preferir uma conversa de verdade, nosso time está por aqui.</p>
            <a href={WPP} class="home-text-link">Falar com a gente <Icon name="diagonal" size={20} /></a>
          </div>
          <div class="faq">
            {faqs.map((faq) => (
              <details class="faq__item" name="faq">
                <summary class="faq__q">{faq.q}<span class="faq__icon" aria-hidden="true"></span></summary>
                <div class="faq__a"><p>{faq.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="home-final">
        <div class="container home-final__inner">
          <span class="home-final__bubble" aria-hidden="true">quero! 💕</span>
          <span class="home-kicker">SUA PRÓXIMA CONVERSA COMEÇA AQUI</span>
          <h2>Menos “te respondo depois”.<br />Mais <span>“já te mandei”.</span></h2>
          <p>Seu conteúdo chama atenção. O Notifiquei cuida da conversa.</p>
          <div class="home-final__actions">
            <a href={FREE} class="btn btn--lg br-only" data-home-cta="final_cta">Começar grátis agora <Icon name="arrow" size={22} /></a>
            <a href="#planos" class="btn btn--lg intl-only" data-home-cta="final_cta">Escolher meu plano <Icon name="arrow" size={22} /></a>
            <small class="br-only">Sem cartão. Sem prazo. Do seu jeito.</small>
            <small class="intl-only">Garantia de 7 dias. Do seu jeito.</small>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>

  <script>
    import { initHomeMotion } from "../scripts/home-motion";
    initHomeMotion();

    document.querySelectorAll<HTMLAnchorElement>("[data-home-cta]").forEach((cta) => {
      cta.addEventListener("click", () => (window as any).posthog?.capture?.("hero_cta_clicked", { section: cta.dataset.homeCta }));
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-show-demo]").forEach((link) => {
      link.addEventListener("click", () => {
        const key = link.dataset.showDemo;
        if (!["comment", "story", "direct"].includes(key ?? "")) return;
        document.querySelector<HTMLButtonElement>(`#demo [data-demo="${key}"]`)?.click();
      });
    });
    document.getElementById("plans-grid")?.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const cta = event.target.closest(".plan__cta");
      if (!cta) return;
      const planName = cta.closest(".plan")?.querySelector(".plan__name")?.textContent?.trim();
      const annual = document.querySelector("#billtoggle [data-cycle='a']")?.getAttribute("aria-pressed") === "true";
      (window as any).posthog?.capture?.("plan_cta_clicked", { plan_name: planName, billing_cycle: annual ? "annual" : "monthly" });
    });
    document.querySelector(".freeplan__cta a")?.addEventListener("click", () => (window as any).posthog?.capture?.("signup_cta_clicked", { plan_name: "Grátis", section: "plans" }));
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[href*="buy.stripe.com"]');
      const language = link?.href.match(/nqlang_([a-zA-Z-]+)/);
      if (language) document.cookie = `nq_lang=${language[1]}; path=/; max-age=3600; SameSite=Lax`;
    }, true);
  </script>
</Base>
