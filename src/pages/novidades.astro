---
/** /novidades — o que mudou no produto (30/09). Conteúdo em src/data/novidades.ts. */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/HomeIcon.astro";
import { copyHome, marcar } from "../i18n/home";
import { novidades } from "../data/novidades";
import "../styles/home.css";

const t = copyHome("pt-BR");
const ROTULO = { novo: "Novo", melhoria: "Melhoria", correcao: "Correção" } as const;
const dia = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString("pt-BR", { day: "2-digit", month: "short", timeZone: "UTC" });
const total = novidades.reduce((n, m) => n + m.itens.length, 0);
---

<Base
  title="Novidades do Notifiquei"
  description={`O que mudou no Notifiquei: ${total} novidades e melhorias nos últimos meses — assistente de criação, vitrine no direct, plano Duo, avisos da Meta e mais.`}
  path="/novidades"
  lang="pt-BR"
>
  <div class="home-page pagina-clara">
    <a href="#conteudo" class="home-skip">{t.meta.skip}</a>
    <Nav links={t.nav} lang="pt-BR" langLabel={t.meta.navLangLabel} comecar={t.meta.navComecar} comecarHref="/precos" />
    <main id="conteudo">
      <section class="pg-head">
        <div class="container">
          <span class="home-kicker"><Icon name="spark" size={17} /> NOVIDADES</span>
          <h1 set:html={marcar("O Notifiquei\n{hl}não para de melhorar.{/hl}")} />
          <p>{total} mudanças nos últimos três meses.</p>
        </div>
      </section>

      <section class="nv-lista">
        <div class="container nv-cont">
          {novidades.map((m) => (
            <section class="nv-mes">
              <h2>{m.mes}</h2>
              <ol>
                {m.itens.map((i) => (
                  <li class="nv-item">
                    <time datetime={i.data}>{dia(i.data)}</time>
                    <div>
                      <span class={`nv-tag nv-tag--${i.tipo}`}>{ROTULO[i.tipo]}</span>
                      <h3>{i.titulo}</h3>
                      <p>{i.texto}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </section>

      <section class="home-final">
        <div class="container home-final__inner">
          <span class="home-final__bubble" aria-hidden="true">tem ideia? 💡</span>
          <span class="home-kicker">SUA SUGESTÃO VIRA NOVIDADE</span>
          <h2 set:html={marcar("Experimente o que\n{span}saiu de novo.{/span}")} />
          <p>Plano grátis pra começar, sem cartão.</p>
          <div class="home-final__actions">
            <a href="/precos" class="btn btn--lg">Ver planos <Icon name="arrow" size={22} /></a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
  <script>
    import { initHomeMotion } from "../scripts/home-motion";
    initHomeMotion();
  </script>
</Base>

<style>
  .nv-lista { padding-bottom: 100px; }
  .nv-cont { max-width: 860px; }
  .nv-mes + .nv-mes { margin-top: 56px; }
  .nv-mes h2 { font-size: 30px; letter-spacing: -.03em; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .nv-mes ol { list-style: none; padding: 0; margin: 0; }
  .nv-item { display: grid; grid-template-columns: 90px 1fr; gap: 22px; padding: 22px 0; border-bottom: 1px solid var(--line-soft); }
  .nv-item time { font-size: 13px; font-weight: 600; color: var(--ink-soft); padding-top: 3px; }
  .nv-item h3 { font-size: 20px; letter-spacing: -.02em; margin-top: 8px; }
  .nv-item p { font-size: 15px; line-height: 1.65; color: var(--ink-soft); margin-top: 6px; }
  .nv-tag { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; padding: 4px 9px; border-radius: 99px; }
  .nv-tag--novo { background: #fbe3ec; color: var(--brand-ink); }
  .nv-tag--melhoria { background: #e3f1e9; color: #1f7a50; }
  .nv-tag--correcao { background: #efe8dd; color: #6d5d49; }
  @media (max-width: 620px) { .nv-item { grid-template-columns: 1fr; gap: 6px; } }
</style>
