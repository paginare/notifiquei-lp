  <script>
    import { iniciarMovimento } from "../../scripts/movimento";
    iniciarMovimento();

    // ---- Busca: filtra funções e dúvidas ao vivo ----
    const norm = (s: string) => (s || "").toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
    const input = document.getElementById("central-search") as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>("[data-search]"));
    const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
    const empties = Array.from(document.querySelectorAll<HTMLElement>("[data-empty]"));
    const secaoDe = (el: Element) => el.closest("section[id]")?.id ?? "";

    function filtrar(raw: string) {
      const q = norm(raw).trim();
      const partes = q.split(/\s+/);
      items.forEach((el) => {
        const texto = el.dataset.search ?? "";
        const ok = !q || partes.every((p) => texto.includes(p));
        el.hidden = !ok;
        if (el instanceof HTMLDetailsElement) el.open = !!q && ok;
      });
      // esconde grupos e títulos de plataforma sem nenhum item visível
      groups.forEach((g) => {
        const visivel = g.matches("h3")
          ? g.nextElementSibling?.querySelector("[data-search]:not([hidden])")
          : g.querySelector("[data-search]:not([hidden])");
        g.hidden = !!q && !visivel;
      });
      empties.forEach((e) => {
        const algum = items.some((el) => secaoDe(el) === e.dataset.empty && !el.hidden);
        e.hidden = !q || algum;
      });
    }
    input?.addEventListener("input", () => filtrar(input.value));

    // ---- Copiar pitch ----
    const copyBtn = document.getElementById("pitch-copy");
    copyBtn?.addEventListener("click", async () => {
      const old = copyBtn.textContent;
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.text ?? "");
        copyBtn.textContent = "Copiado ✓";
      } catch {
        copyBtn.textContent = "Selecione e copie";
      }
      setTimeout(() => { copyBtn.textContent = old; }, 1800);
    });
  </script>
</Base>

