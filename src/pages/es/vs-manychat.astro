---
/** /es/vs-manychat no visual novo (30/09/2026). Corpo em components/PaginaVsIntl.astro. */
import Base from "../../layouts/Base.astro";
import PaginaVsIntl from "../../components/PaginaVsIntl.astro";
import { vs } from "../../i18n/paginas-intl";
import "../../styles/home.css";

const c = vs.es;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: c.faq.itens.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={c.title} description={c.description} path="/es/vs-manychat" hreflangOf="/vs-manychat" lang="es" jsonLd={jsonLd}>
  <PaginaVsIntl lang="es" />
</Base>
