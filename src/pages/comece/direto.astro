---
/**
 * LP de teste para tráfego de anúncio (out/2026). Mesma cara da home (mesmos
 * componentes), com o que os dados de 18/10 pediram:
 * - quem vem do anúncio fica ~7 s na primeira tela → o hero repete a promessa
 *   do anúncio e já mostra preço, garantia e "sem fidelidade";
 * - 71 de 85 vendas foram no mensal, mas a tabela abria no anual → aqui abre no mensal;
 * - sem plano grátis e sem "Entrar" (cliente antigo tem a home).
 * src=lp-direto vai no link da Cakto para medir as vendas desta página.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Icon from "../../components/HomeIcon.astro";
import HomeHero from "../../components/HomeHero.astro";
import HomeAuthority from "../../components/HomeAuthority.astro";
import HomeStories from "../../components/HomeStories.astro";
import HomeDemo from "../../components/HomeDemo.astro";
import HomeTour from "../../components/HomeTour.astro";
import HomeCasos from "../../components/HomeCasos.astro";
import HomePricing from "../../components/HomePricing.astro";
import StickyCta from "../../components/StickyCta.astro";
import ZapFlutuante from "../../components/ZapFlutuante.astro";
import { copyHome, marcar } from "../../i18n/home";
import { WPP } from "../../data/home";
import "../../styles/home.css";

const SRC = "lp-direto";
const base = copyHome("pt-BR");
const PRECO = "R$ 99/mês · 7 dias de garantia · sem fidelidade";

// Hero: a promessa do anúncio que mais trouxe gente ("quem comenta ou manda
// direct recebe o seu link na hora, no automático").
const hero = {
  ...base.hero,
  titulo: ["Comentou?", "Recebeu o link", "na hora."],
  lead: 'Quem comenta no seu post ou chama no direct recebe <strong>o seu link na hora</strong>. No Instagram e no TikTok, 24 horas por dia, com mensagens que têm o seu jeito.',
  ctaBr: "Quero testar 7 dias",
  microBr: PRECO,
};

const t = {
  ...base,
  planos: {
    ...base.planos,
    leadBr: "Comece no mensal, sem fidelidade. Se em 7 dias não fizer sentido, devolvemos 100%.",
  },
  final: {
    ...base.final,
    ctaBr: "Quero testar 7 dias",
    microBr: "7 dias de garantia. Sem fidelidade. Cancele quando quiser.",
  },
};

const passos = [
  { n: "01", icon: "instagram", titulo: "Conecte seu Instagram", texto: "Pelo login oficial da Meta. Sua senha continua só com você." },
  { n: "02", icon: "chat", titulo: "Escolha a palavra e o link", texto: "Ex.: quem comentar QUERO recebe o link do seu produto, curso ou catálogo. Tem modelos prontos." },
  { n: "03", icon: "bolt", titulo: "Pronto. Pode postar.", texto: "Cada comentário vira uma mensagem no direct, na hora, até de madrugada." },
];

// Dúvidas de quem nunca ouviu falar do Notifiquei (tráfego frio).
const faqs = [
  { q: "Minha conta corre risco de bloqueio?", a: "Não. O Notifiquei usa a conexão oficial da Meta e é parceiro oficial da Meta e do TikTok. Nada de senha, nada de robô escondido." },
  { q: "Preciso entender de tecnologia?", a: "Não. Você escolhe o post, a palavra e escreve a mensagem com o seu link. Tem modelos prontos para começar em poucos minutos." },
  { q: "E se eu não gostar?", a: "Você tem 7 dias de garantia. Pediu, devolvemos 100% do valor." },
  { q: "Tem fidelidade ou multa?", a: "Não. O plano é mensal e você cancela quando quiser." },
  { q: "Funciona no TikTok também?", a: "Sim. O plano Solo vale para 1 conta, com Instagram e TikTok." },
  { q: "Preciso de conta profissional?", a: "Sim, comercial ou de criador. É grátis e você muda nas configurações do próprio Instagram em 1 minuto." },
];
---

<Base
  title="Notifiquei — Comentou? Recebeu o link na hora."
  description="Quem comenta no seu post ou chama no direct recebe o seu link na hora. No Instagram e no TikTok, 24 horas por dia."
  path="/comece/direto"
  canonicalPath="/"
  noindex
  heroPoster="/assets/home/creator-hero-v4.webp"
  heroPosterSrcset="/assets/home/creator-hero-v4-760.webp 760w, /assets/home/creator-hero-v4.webp 1120w"
  heroPosterSizes="(max-width: 900px) 100vw, 50vw"
  lang="pt-BR"
>
  <div class="home-page lp-direto">
    <a href="#conteudo" class="home-skip">{base.meta.skip}</a>
    <Nav links={[{ href: "#plataforma", label: "Como funciona" }, { href: "#planos", label: "Preço" }, { href: "#faq", label: "Dúvidas" }]} comecar="Quero testar" comecarHref="#planos" entrar="" />
    <main id="conteudo">
      <HomeHero t={hero} conversa={base.conversa} />

      <HomeAuthority t={base.autoridade} />

      <section class="home-proof" aria-label={base.provaMarcas}>
        <div class="container">
          <HomeStories titulo={base.perfisTitulo} />
        </div>
      </section>

      <section class="home-section home-before-after">
        <div class="container">
          <div class="home-centered-heading">
            <span class="home-kicker">{base.antesDepois.kicker}</span>
            <h2 set:html={marcar(base.antesDepois.titulo)} />
          </div>
          <div class="home-comparison">
            <article class="home-comparison__before">
              <span class="home-comparison__label">{base.antesDepois.antesRotulo}</span>
              <h3 set:html={marcar(base.antesDepois.antesTitulo)} />
              <div class="waiting-messages" aria-label={base.antesDepois.antesRotulo}>
                {base.antesDepois.esperando.map((msg, i) => <span>{msg} <span>{["👀", "💬", "🙋"][i]}</span></span>)}
              </div>
              <ul>
                {base.antesDepois.antesItens.map((item) => <li><Icon name="minus" size={18} /> {item}</li>)}
              </ul>
            </article>
            <article class="home-comparison__after">
              <span class="home-comparison__label"><img src="/assets/favicon.svg" alt="" width="25" height="25" /> {base.antesDepois.depoisRotulo}</span>
              <h3 set:html={marcar(base.antesDepois.depoisTitulo)} />
              <div class="answered-message"><span><Icon name="check" size={22} /></span><div><b>{base.antesDepois.enviado}</b><small>{base.antesDepois.enviadoSub}</small></div><Icon name="spark" size={25} /></div>
              <ul>
                {base.antesDepois.depoisItens.map((item) => <li><Icon name="check" size={18} /> {item}</li>)}
              </ul>
              <a href="#planos" class="home-text-link" data-home-cta="lpd_antes_depois">Quero testar 7 dias <Icon name="arrow" size={19} /></a>
            </article>
          </div>
        </div>
      </section>

      <HomeDemo t={base.demo} />

      <HomeTour />

      <HomeCasos />

      <section class="home-section home-how" id="como">
        <div class="container">
          <div class="home-centered-heading">
            <span class="home-section-symbol"><Icon name="bolt" size={29} /></span>
            <h2 set:html={marcar("Liga em poucos minutos.\n{hl}Sem código, sem complicação.{/hl}")} />
            <p>Três passos entre o seu post e a primeira resposta automática.</p>
          </div>
          <ol class="home-steps">
            {passos.map((step) => (
              <li><div class="home-step__top"><span>{step.n}</span><Icon name={step.icon} size={28} /></div><h3>{step.titulo}</h3><p>{step.texto}</p></li>
            ))}
          </ol>
          <div class="home-how__actions">
            <a href="#planos" class="btn btn--brand btn--lg" data-home-cta="lpd_passos">Quero testar 7 dias <Icon name="arrow" size={20} /></a>
            <span><Icon name="shield" size={18} /> {base.como.seguranca}</span>
          </div>
        </div>
      </section>

      <HomePricing t={t.planos} lang="pt-BR" src={SRC} gratis={false} ciclo="m" />

      <section class="home-section home-faq" id="faq">
        <div class="container home-faq__grid">
          <div class="home-faq__intro">
            <span class="home-kicker">{base.faq.kicker}</span>
            <h2 set:html={marcar(base.faq.titulo)} />
            <p>{base.faq.lead}</p>
            <a href={WPP} class="home-text-link" data-zap="faq">{base.faq.cta} <Icon name="diagonal" size={20} /></a>
            <img class="home-faq__noti" src="/assets/home/noti/noti-pensando-160.webp" srcset="/assets/home/noti/noti-pensando-160.webp 160w, /assets/home/noti/noti-pensando-320.webp 320w" sizes="(max-width: 900px) 72px, 128px" width="160" height="159" alt="" loading="lazy" decoding="async" />
          </div>
          <div class="faq">
            {faqs.map((faq) => (
              <details class="faq__item" name="faq">
                <summary class="faq__q">{faq.q}<span class="faq__icon" aria-hidden="true"></span></summary>
                <div class="faq__a"><p>{faq.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="home-final">
        <div class="container home-final__inner">
          <span class="home-final__bubble" aria-hidden="true">{t.final.bolha}</span>
          <span class="home-kicker">{t.final.kicker}</span>
          <h2 set:html={marcar(t.final.titulo)} />
          <p>{t.final.lead}</p>
          <div class="home-final__actions">
            <a href="#planos" class="btn btn--lg" data-home-cta="lpd_final">{t.final.ctaBr} <Icon name="arrow" size={22} /></a>
            <small>{t.final.microBr}</small>
          </div>
        </div>
      </section>
    </main>
    <Footer />
    <ZapFlutuante texto="Oi! Vim pelo anúncio do Notifiquei e queria tirar uma dúvida." rotulo={base.zapRotulo} />
    <StickyCta href="#planos" titulo="R$ 99/mês" sub="7 dias de garantia · sem fidelidade" cta="Quero testar" />
  </div>

  <script>
    import { iniciarMovimento } from "../../scripts/movimento";
    iniciarMovimento();

    const ph = () => (window as any).posthog;
    document.querySelectorAll<HTMLAnchorElement>("[data-home-cta]").forEach((cta) => {
      cta.addEventListener("click", () => ph()?.capture?.("hero_cta_clicked", { section: cta.dataset.homeCta, page: "lp-direto" }));
    });
    document.getElementById("plans-grid")?.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const cta = event.target.closest(".plan__cta");
      if (!cta) return;
      const planName = cta.closest(".plan")?.querySelector(".plan__name")?.textContent?.trim();
      const annual = document.querySelector("#billtoggle [data-cycle='a']")?.getAttribute("aria-pressed") === "true";
      ph()?.capture?.("plan_cta_clicked", { plan_name: planName, billing_cycle: annual ? "annual" : "monthly", page: "lp-direto" });
    });
  </script>
</Base>
