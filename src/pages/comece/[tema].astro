---
/**
 * Landing de tráfego pago: mesmo visual da home, com o hero repetindo a promessa
 * do anúncio e sem o plano grátis (a campanha otimiza para InitiateCheckout).
 * Página estática por tema — nada de trocar copy via JS, que piscaria o hero e
 * atrasaria o LCP. Temas em src/data/lp-trafego.ts.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import HomeHero from "../../components/HomeHero.astro";
import HomeAuthority from "../../components/HomeAuthority.astro";
import HomeDemo from "../../components/HomeDemo.astro";
import HomePricing from "../../components/HomePricing.astro";
import { copyHome } from "../../i18n/home";
import { temas, conversaLp } from "../../data/lp-trafego";
import "../../styles/home.css";

export function getStaticPaths() {
  return Object.keys(temas).map((tema) => ({ params: { tema } }));
}

const { tema } = Astro.params as { tema: string };
const t = copyHome("pt-BR");
const hero = { ...t.hero, ...temas[tema], canais: { nota: "AUTOMAÇÃO DE DM" }, microBr: t.planos.garantia };
const conversa = { ...t.conversa, topo: conversaLp.topo, respondeu: conversaLp.respondeu, exemplos: [conversaLp.exemplo] };
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={`/comece/${tema}`}
  canonicalPath="/"
  noindex
  heroPoster="/assets/home/creator-hero-v3.webp"
  lang="pt-BR"
>
  <div class="home-page lp-trafego">
    <Nav links={[{ href: "#planos", label: "Planos" }]} comecar={t.meta.navComecar} comecarHref="#planos" />
    <main id="conteudo">
      <HomeHero t={hero} conversa={conversa} imagensConversa={[conversaLp.imagem]} />
      <HomeAuthority t={t.autoridade} />
      {/* Planos antes da demo: quem vem de anúncio já viu a proposta no hero. */}
      <HomePricing t={t.planos} lang="pt-BR" src={`lp-${tema}`} gratis={false} />
      <HomeDemo t={t.demo} />
    </main>
    <Footer />
  </div>

  <script>
    import { initHomeMotion } from "../../scripts/home-motion";
    initHomeMotion();
  </script>
  <style is:global>
    /* Rótulos do card animado legíveis no celular (na home são 9px). */
    .lp-trafego .hero-chat__incoming small, .lp-trafego .hero-chat__sender { font-size: 11.5px; }
    .lp-trafego .hero-chat__top > span { font-size: 12.5px; font-weight: 600; }
  </style>
</Base>
