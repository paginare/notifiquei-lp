---
/**
 * Landing de tráfego pago: mesmo visual da home, com o hero repetindo a promessa
 * do anúncio e sem o plano grátis (a campanha otimiza para InitiateCheckout).
 * Página estática por tema — nada de trocar copy via JS, que piscaria o hero e
 * atrasaria o LCP. Temas em src/data/lp-trafego.ts.
 */
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import LpHero from "../../components/LpHero.astro";
import HomeAuthority from "../../components/HomeAuthority.astro";
import HomeDemo from "../../components/HomeDemo.astro";
import HomePricing from "../../components/HomePricing.astro";
import { copyHome } from "../../i18n/home";
import { temas } from "../../data/lp-trafego";
import { plans } from "../../data/home";
import { mensalNoAnual } from "../../i18n/planos";
import "../../styles/home.css";

export function getStaticPaths() {
  return Object.keys(temas).map((tema) => ({ params: { tema } }));
}

const { tema } = Astro.params as { tema: string };
const t = copyHome("pt-BR");
// Preço junto do botão, calculado do plano mais barato (Solo, no anual — o toggle abre no anual).
const precoMicro = `A partir de R$ ${mensalNoAnual(plans[0].price)}/mês no anual · 7 dias de garantia`;
---

<Base
  title={t.meta.title}
  description={t.meta.description}
  path={`/comece/${tema}`}
  canonicalPath="/"
  noindex
  heroPoster="/assets/creators/day-morning.webp"
  lang="pt-BR"
>
  <div class="home-page lp-trafego">
    <Nav links={[{ href: "#planos", label: "Planos" }]} comecar={t.meta.navComecar} comecarHref="#planos" entrar="" />
    <main id="conteudo">
      <LpHero tema={temas[tema]} micro={precoMicro} />
      {/* Planos logo após o hero: no PostHog a rolagem mediana ficou em ~18% e
          quase ninguém chegava nos planos quando vinham depois da autoridade. */}
      <HomePricing t={t.planos} lang="pt-BR" src={`lp-${tema}`} gratis={false} />
      <HomeAuthority t={t.autoridade} />
      <HomeDemo t={t.demo} />
    </main>
    <Footer />
  </div>

  <script>
    import { initHomeMotion } from "../../scripts/home-motion";
    initHomeMotion();
  </script>
  <style is:global>
    /* Hero claro nas LPs: o menu fica sempre na versão "rolada" (fundo papel). */
    .home-page.lp-trafego .nav, .home-page.lp-trafego #siteNav.nav { background: var(--paper); color: var(--ink); box-shadow: 0 2px 15px #14100e0a; }
    .home-page.lp-trafego .nav:not(.is-scrolled):not(.is-open) .nav__links a { color: var(--ink-soft); }
    .home-page.lp-trafego .nav .nav__start { background: var(--brand-ink); color: #fff; }
    .home-page.lp-trafego .nav .lang__btn { border-color: var(--line); background: transparent; }
  </style>
</Base>
