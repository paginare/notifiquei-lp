---
import "../styles/global.css";
import PostHog from '../components/posthog.astro';
import Gtm from '../components/Gtm.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: object[];
  noindex?: boolean;
  canonicalPath?: string; // força o canonical p/ outra rota (ex.: variantes A/B → "/")
  heroPoster?: string; // pré-carrega o poster do vídeo do hero (LCP) quando informado
  ogImagePath?: string; // imagem de compartilhamento própria da página (ex.: capa gerada do post)
  ogType?: string; // "article" nos posts do blog, "website" no resto
  lang?: "pt-BR" | "en" | "es"; // idioma da página (só a home tem /en e /es)
  hreflangOf?: string; // rota-base que tem traduções, p/ emitir os alternates (ex.: "/")
}

const {
  title = "Notifiquei — Automação de Instagram pela API oficial da Meta",
  description = "O Notifiquei responde DMs, comentários e stories no Instagram em segundos, com a sua voz, pela API oficial da Meta. Você cria. Ele converte.",
  path = "/",
  jsonLd = [],
  noindex = false,
  canonicalPath,
  heroPoster,
  ogImagePath,
  ogType = "website",
  lang = "pt-BR",
  hreflangOf,
} = Astro.props;

const site = "https://notifiquei.com.br";
// home sem barra final, p/ casar com o sitemap (trailingSlash: never)
const canonicalTarget = canonicalPath ?? path;
const canonical = canonicalTarget === "/" ? site : site + canonicalTarget;
// ?v=2 força WhatsApp/Facebook a re-buscar a imagem (eles cacheiam por URL)
// Posts do blog passam ogImagePath com a capa gerada; o resto usa a imagem padrão.
const ogImage = site + (ogImagePath ?? "/assets/og-image.jpg?v=2");

// Schema WebSite (site inteiro) — ajuda buscadores e IAs a entender a marca.
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": site + "/#website",
  url: site,
  name: "Notifiquei",
  publisher: { "@id": site + "/#org" },
  inLanguage: lang,
};

// hreflang recíproco. Só emitido nas páginas que realmente têm tradução — apontar
// alternate pra rota inexistente é pior que não ter alternate nenhum.
const IDIOMAS = [
  { code: "pt-BR", prefixo: "" },
  { code: "en", prefixo: "/en" },
  { code: "es", prefixo: "/es" },
];
const alternates = hreflangOf
  ? IDIOMAS.map((i) => ({
      code: i.code,
      href: site + (hreflangOf === "/" ? i.prefixo || "/" : i.prefixo + hreflangOf),
    }))
  : [];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!--
    Consentimento ANTES do GTM, e sem async/defer de propósito: ele precisa
    rodar e negar o Consent Mode v2 antes de o gtm.js existir. Invertida a
    ordem, o GTM sobe com o default "granted" e o cookie já foi gravado
    quando o banner aparece — o banner viraria enfeite.
  -->
  <script is:inline src="/assets/cookie-consent.js"></script>
  <Gtm />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={site} />}
  <meta name="theme-color" content="#FBF7F0" />

  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/assets/favicon-180.png" />

  <!-- Open Graph / Twitter -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Notifiquei" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Preload das fontes críticas -->
  <link rel="preload" href="/assets/fonts/bricolage-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/jakarta-400.woff2" as="font" type="font/woff2" crossorigin />

  <!-- Poster do hero como prioridade — preenche a área do hero cedo (melhora Speed Index) -->
  {heroPoster && <link rel="preload" href={heroPoster} as="image" fetchpriority="high" />}

  {jsonLd.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))}
  <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
  <PostHog />
</head>
<body>
  <!--
    O <noscript> do GTM foi removido: é um pixel que dispara sem passar pelo
    Consent Mode e sem como ser bloqueado (justamente porque não há JS pra
    perguntar nada). Mantê-lo seria rastrear sem consentimento por um caminho
    que o banner não alcança, e o que se perde é o tráfego sem JavaScript.
  -->
  <div class="grain" aria-hidden="true"></div>
  <slot />

  <script>
    // Encaminha params de tracking da URL de ENTRADA (afiliado/anúncio) para os CTAs
    // de checkout Cakto e signup, sem pisar no que a pessoa já usa. Se a entrada traz
    // um param (ex.: affiliate/src de afiliado), ele VENCE o nosso fallback (src=home/v2/v3).
    (() => {
      const TRACK_KEYS = ["affiliate", "src", "sck", "xcode", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "fbclid", "ttclid", "gad_source"];
      const incoming = new URLSearchParams(window.location.search);
      let carry = TRACK_KEYS.filter((k) => incoming.get(k));
      // Site é MPA: a query não acompanha a navegação interna. Guarda os params da
      // entrada na sessão e restaura em páginas sem query, pra atribuição não se perder.
      try {
        if (carry.length) {
          sessionStorage.setItem("nf_track", JSON.stringify(Object.fromEntries(carry.map((k) => [k, incoming.get(k)]))));
        } else {
          const saved = JSON.parse(sessionStorage.getItem("nf_track") || "{}");
          TRACK_KEYS.forEach((k) => { if (saved[k]) incoming.set(k, String(saved[k])); });
          carry = TRACK_KEYS.filter((k) => incoming.get(k));
        }
      } catch {}
      if (!carry.length) return;
      const merge = (raw: string) => {
        try {
          const u = new URL(raw, window.location.origin);
          carry.forEach((k) => u.searchParams.set(k, incoming.get(k)!));
          return u.toString();
        } catch { return raw; }
      };
      const tracked = (h: string | null) => !!h && /pay\.cakto\.com\.br|app\.notifiquei\.com\.br\/auth/.test(h);
      document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
        const h = a.getAttribute("href");
        if (tracked(h)) a.setAttribute("href", merge(h!));
        if (a.dataset.hrefM) a.dataset.hrefM = merge(a.dataset.hrefM); // mensal (toggle)
        if (a.dataset.hrefA) a.dataset.hrefA = merge(a.dataset.hrefA); // anual (toggle)
      });
    })();

    // Reveal no scroll — robusto em todo navegador, respeita reduced-motion.
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Vídeos: preload="none" + data-autoplay. Só começam a carregar/tocar quando
    // entram na tela, e a observação só arranca quando a thread fica ociosa — assim
    // o vídeo não disputa banda nem main-thread com a fonte/LCP no carregamento inicial.
    // reduced-motion: ficam pausados, mostrando o poster.
    const vids = document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]");
    if (!prefersReduced && vids.length) {
      const start = (v: HTMLVideoElement) => v.play().catch(() => {});
      if ("IntersectionObserver" in window) {
        const vio = new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { start(e.target as HTMLVideoElement); obs.unobserve(e.target); }
          });
        }, { rootMargin: "200px 0px" });
        const kick = () => vids.forEach((v) => vio.observe(v));
        if ("requestIdleCallback" in window) (window as any).requestIdleCallback(kick, { timeout: 2000 });
        else window.addEventListener("load", () => setTimeout(kick, 200), { once: true });
      } else {
        vids.forEach(start);
      }
    }

    const els = document.querySelectorAll<HTMLElement>(".reveal");
    if (prefersReduced || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
      );
      els.forEach((el) => io.observe(el));
    }

    // Nav: sombra ao rolar
    const nav = document.querySelector(".nav");
    if (nav) {
      const onScroll = () => nav.classList.toggle("is-scrolled", window.scrollY > 12);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    }
  </script>
</body>
</html>
