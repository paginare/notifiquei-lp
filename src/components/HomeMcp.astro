---
// Conector MCP: criar automação conversando com o Claude.
// A simulação é uma janela de app de conversa. As ferramentas são as que o
// conector expõe de verdade (listar_posts, prever_automacao, criar_automacao)
// e o pedido de permissão existe mesmo: nada é criado sem confirmação.
import Icon from "./HomeIcon.astro";
import { marcar, type CopyHome } from "../i18n/home";

interface Props { t: CopyHome["mcp"]; }
const { t } = Astro.props;
const [pedidoAntes, pedidoDepois] = t.pedido.split(/\{hl\}|\{\/hl\}/).filter((_, i) => i !== 1);
const cupom = (t.pedido.match(/\{hl\}([\s\S]*?)\{\/hl\}/) ?? [])[1] ?? "";
const [permAntes, permDepois] = t.permissao.split("{tool}");
---

<section class="home-section home-mcp" id="mcp" aria-labelledby="mcp-title">
  <div class="container home-mcp__grid">
    <div class="home-mcp__copy">
      <span class="home-kicker">{t.kicker}</span>
      <h2 id="mcp-title" set:html={marcar(t.titulo)} />
      <p class="home-mcp__lead">{t.lead}</p>
      <ul class="home-mcp__list">
        {t.itens.map((item) => <li><Icon name="check" size={16} /> {item}</li>)}
      </ul>
      <a href="#planos" class="btn btn--brand btn--lg br-only" data-home-cta="mcp">{t.ctaBr} <Icon name="arrow" size={21} /></a>
      <a href="#planos" class="btn btn--brand btn--lg intl-only" data-home-cta="mcp">{t.ctaIntl} <Icon name="arrow" size={21} /></a>
    </div>

    <figure class="mcp-app" aria-label={t.aria}>
      <div class="mcp-app__bar">
        <span class="mcp-app__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mcp-app__title"><img src="/assets/home/claude-app-icon.png" width="18" height="18" alt="" loading="lazy" /> Claude</span>
        <span class="mcp-app__badge"><i class="mcp-app__on" aria-hidden="true"></i> {t.conectado}</span>
      </div>

      <div class="mcp-app__body">
        <aside class="mcp-app__side" aria-hidden="true">
          <span class="mcp-app__side-new">{t.novaConversa}</span>
          {t.conversas.map((c, i) => <span class={`mcp-app__side-item ${i === 0 ? "is-on" : ""}`}>{c}</span>)}
        </aside>

        <div class="mcp-app__thread">
          <p class="mcp-msg mcp-msg--you">{pedidoAntes}<b>{cupom}</b>{pedidoDepois}</p>

          <div class="mcp-orb" data-orb hidden aria-hidden="true">
            <span class="mcp-orb__halo"></span>
            <img src="/assets/home/claude-app-icon.png" width="22" height="22" alt="" loading="lazy" />
            <span class="mcp-orb__dots"><i></i><i></i><i></i></span>
          </div>

          <p class="mcp-say"><img class="mcp-avatar" src="/assets/home/claude-app-icon.png" width="22" height="22" alt="" loading="lazy" /><span>{t.achou}</span></p>
          <span class="mcp-tool"><Icon name="spark" size={12} /> notifiquei · listar_posts · prever_automacao</span>

          <div class="mcp-preview">
            {t.previa.map((linha) => <div class="mcp-preview__row"><small>{linha.rotulo}</small><b>{linha.valor}</b></div>)}
          </div>

          <div class="mcp-permit">
            <p class="mcp-permit__q">{permAntes}<b>criar_automacao</b>{permDepois}</p>
            <span class="mcp-permit__btns" aria-hidden="true">
              <span class="mcp-permit__btn is-primary">{t.permitirUma}</span>
              <span class="mcp-permit__btn">{t.permitirSempre}</span>
            </span>
          </div>

          <p class="mcp-say mcp-say--done"><img class="mcp-avatar" src="/assets/home/claude-app-icon.png" width="22" height="22" alt="" loading="lazy" /><span set:html={t.pronto} /></p>

          <div class="mcp-app__input" aria-hidden="true"><span>{t.responder}</span><i></i></div>
        </div>
      </div>
      <span class="mcp-cursor" data-cursor hidden aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 2.5 19 12l-6.4 1.3L9.7 19 5 2.5Z" fill="#1f1c14" stroke="#fff" stroke-width="1.4" stroke-linejoin="round" /></svg>
      </span>
      <figcaption>{t.legenda}</figcaption>
    </figure>
  </div>
</section>

<style>
  .home-mcp { background: var(--paper-2); }
  .home-mcp__grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 60px; align-items: center; }
  .home-mcp h2 { font-size: clamp(2.5rem, 3.4vw, 3.3rem); line-height: 1.05; margin-top: 18px; letter-spacing: -.035em; }
  .home-mcp h2 span { color: var(--brand-ink); }
  .home-mcp__lead { font-size: 16px; line-height: 1.75; color: var(--ink-soft); margin-top: 20px; max-width: 46ch; }
  .home-mcp__list { display: grid; gap: 11px; margin-top: 26px; }
  .home-mcp__list li { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.55; }
  .home-mcp__list svg { flex: none; margin-top: 3px; color: var(--brand-ink); }
  .home-mcp .btn { margin-top: 30px; }

  /* Janela na paleta clara do Claude (areia + terracota). O rosa aparece só no
     que é do Notifiquei: o selo do conector e a prévia da automação. */
  .mcp-app { position: relative; margin: 0; border-radius: 14px; overflow: hidden; background: #faf9f5; border: 1px solid #e6e1d4; box-shadow: 0 26px 60px #2b1c0e1f; }
  .mcp-app__bar { display: flex; align-items: center; gap: 12px; padding: 10px 13px; background: #f0eee6; border-bottom: 1px solid #e6e1d4; }
  .mcp-app__lights { display: flex; gap: 6px; }
  .mcp-app__lights i { width: 10px; height: 10px; border-radius: 50%; background: #d9d4c6; }
  .mcp-app__lights i:first-child { background: #ff5f57; }
  .mcp-app__lights i:nth-child(2) { background: #febc2e; }
  .mcp-app__lights i:last-child { background: #28c840; }
  .mcp-app__title { flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px; font-size: 12px; color: #4a4437; letter-spacing: .01em; }
  .mcp-app__title img { border-radius: 4px; }
  .mcp-app__badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border-radius: 999px; background: #fff; border: 1px solid #e6e1d4; color: #5c5446; font-size: 10.5px; }
  .mcp-app__on { width: 6px; height: 6px; border-radius: 50%; background: #2f9e5f; }
  .mcp-app__body { display: grid; grid-template-columns: 138px 1fr; min-height: 388px; }
  .mcp-app__side { display: flex; flex-direction: column; gap: 6px; padding: 13px 9px; background: #f0eee6; border-right: 1px solid #e6e1d4; }
  .mcp-app__side-new { padding: 7px 9px; border-radius: 8px; background: #fff; border: 1px solid #e0dacb; color: #5c5446; font-size: 10.5px; }
  .mcp-app__side-item { padding: 7px 9px; border-radius: 8px; color: #7c7263; font-size: 10.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mcp-app__side-item.is-on { background: #e4e0d3; color: #3d3929; }
  .mcp-app__thread { display: grid; align-content: start; gap: 12px; padding: 18px; background: #faf9f5; }
  .mcp-msg--you { justify-self: end; max-width: 88%; padding: 11px 14px; border-radius: 15px 15px 5px 15px; background: #f0eee6; color: #3d3929; font-size: 13.5px; line-height: 1.55; }
  .mcp-msg--you b { color: var(--brand-ink); font-weight: 700; }
  .mcp-say { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; font-size: 13.5px; line-height: 1.6; color: #3d3929; max-width: 48ch; }
  .mcp-avatar { border-radius: 5px; margin-top: 1px; }
  .mcp-say--done b { color: #1f1c14; }
  .mcp-tool { display: inline-flex; align-items: center; gap: 6px; justify-self: start; margin-left: 32px; padding: 4px 9px; border-radius: 7px; background: #fdeee7; border: 1px solid #f2d3c3; color: #b4562f; font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 10.5px; }
  .mcp-preview { display: grid; gap: 1px; margin-left: 32px; background: #e6e1d4; border: 1px solid #e6e1d4; border-radius: 12px; overflow: hidden; }
  .mcp-preview__row { display: grid; grid-template-columns: 82px 1fr; gap: 12px; align-items: baseline; padding: 9px 12px; background: #fff; }
  .mcp-preview__row small { font-size: 9.5px; letter-spacing: .06em; text-transform: uppercase; color: #8d8474; }
  .mcp-preview__row b { font-size: 12.5px; font-weight: 600; color: #2f2b21; line-height: 1.45; }
  .mcp-permit { margin-left: 32px; padding: 12px 14px; border: 1px solid #e6e1d4; border-radius: 12px; background: #fff; }
  .mcp-permit__q { font-size: 12.5px; color: #3d3929; }
  .mcp-permit__q b { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 11.5px; color: #b4562f; font-weight: 400; }
  .mcp-permit__btns { display: flex; gap: 8px; margin-top: 10px; }
  .mcp-permit__btn { padding: 6px 12px; border-radius: 8px; border: 1px solid #e0dacb; color: #5c5446; font-size: 11.5px; background: #fff; transition: filter .15s, transform .15s; }
  .mcp-permit__btn.is-press { filter: brightness(.94); transform: scale(.97); }
  /* Depois do "sempre permitir" o pedido sai da conversa, como no Claude Code. */
  .mcp-permit { overflow: hidden; max-height: 220px; transition: opacity .3s, transform .3s, max-height .45s cubic-bezier(.3,.7,.3,1), padding .3s, margin .3s, border-color .3s; }
  .mcp-permit.is-oculto { opacity: 0; transform: translateY(-8px); max-height: 0; padding-block: 0; border-color: transparent; }
  .mcp-permit__btn.is-primary { background: #3d3929; border-color: transparent; color: #faf9f5; font-weight: 600; }
  .mcp-app__input { display: flex; align-items: center; justify-content: space-between; margin-top: 4px; padding: 10px 12px; border: 1px solid #e0dacb; border-radius: 12px; background: #fff; color: #8d8474; font-size: 12px; }
  .mcp-app__input i { width: 20px; height: 20px; border-radius: 6px; background: #efece2; }
  .mcp-app figcaption { padding: 11px 14px; background: #f0eee6; border-top: 1px solid #e6e1d4; color: #7c7263; font-size: 10.5px; }

  /* Entrada da conversa, uma linha por vez. O estado escondido só é aplicado
     pelo script (data-anim), então sem JS ou com movimento reduzido a janela
     aparece inteira e legível. */
  /* Os atrasos vão por classe, não por posição: o orb entra no meio da lista e
     a contagem por nth-child quebrava toda a sequência. */
  .mcp-app__thread[data-anim] > *:not([data-orb]) { opacity: 0; transform: translateY(14px); }
  .mcp-app__thread[data-anim="entra"] > *:not([data-orb]) { animation: mcp-entra .5s cubic-bezier(.22,.7,.28,1) both; }
  .mcp-app__thread[data-anim="entra"] .mcp-msg--you { animation-delay: 0s; }
  .mcp-app__thread[data-anim="entra"] .mcp-say:not(.mcp-say--done) { animation-delay: 1.4s; }
  .mcp-app__thread[data-anim="entra"] .mcp-tool { animation-delay: 1.75s; }
  .mcp-app__thread[data-anim="entra"] .mcp-preview { animation-delay: 2.1s; }
  .mcp-app__thread[data-anim="entra"] .mcp-permit { animation-delay: 2.5s; }
  /* A confirmação e o campo de resposta NÃO entram por tempo: só depois que o
     clique na permissão acontece (a classe vem do script). Se a cena atrasar
     num aparelho lento, a ordem continua verdadeira. */
  .mcp-app__thread[data-anim] .mcp-say--done,
  .mcp-app__thread[data-anim] .mcp-app__input { animation: none; opacity: 0; transform: translateY(14px); }
  .mcp-app__thread.is-confirmado .mcp-say--done { animation: mcp-entra .5s cubic-bezier(.22,.7,.28,1) both; animation-delay: .15s; }
  .mcp-app__thread.is-confirmado .mcp-app__input { animation: mcp-entra .5s cubic-bezier(.22,.7,.28,1) both; animation-delay: .45s; }

  /* Orb: o Claude "pensando" antes da primeira resposta. */
  .mcp-orb { position: relative; display: inline-flex; align-items: center; gap: 9px; justify-self: start; padding: 7px 13px 7px 9px; border-radius: 999px; background: #f4f1e8; border: 1px solid #e6e1d4; }
  .mcp-orb[hidden] { display: none; }
  .mcp-orb img { position: relative; z-index: 1; border-radius: 5px; animation: orb-gira 3.2s linear infinite; }
  .mcp-orb__halo { position: absolute; left: 4px; width: 32px; height: 32px; border-radius: 50%; background: radial-gradient(circle, #d9775766 0%, #d9775700 70%); animation: orb-pulsa 1.5s ease-in-out infinite; }
  .mcp-orb__dots { display: flex; gap: 4px; }
  .mcp-orb__dots i { width: 5px; height: 5px; border-radius: 50%; background: #b4562f; animation: orb-ponto 1.1s ease-in-out infinite; }
  .mcp-orb__dots i:nth-child(2) { animation-delay: .18s; }
  .mcp-orb__dots i:nth-child(3) { animation-delay: .36s; }
  @keyframes orb-gira { to { transform: rotate(360deg); } }
  @keyframes orb-pulsa { 0%, 100% { transform: scale(.85); opacity: .5; } 50% { transform: scale(1.15); opacity: 1; } }
  @keyframes orb-ponto { 0%, 100% { opacity: .3; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-2px); } }

  /* Cursor falso. position:absolute é essencial: sem isso ele entra no fluxo,
     empurra o conteúdo e "abre um espaço" quando aparece. */
  .mcp-cursor { position: absolute; top: 0; left: 0; z-index: 4; pointer-events: none; transform: translate(var(--x, 50%), var(--y, 60%)); transition: transform .75s cubic-bezier(.33,.9,.35,1); filter: drop-shadow(0 3px 6px #1f1c1433); }
  .mcp-cursor[hidden] { display: none; }
  .mcp-cursor.is-click { transform: translate(var(--x, 50%), var(--y, 60%)) scale(.82); transition-duration: .12s; }

  @keyframes mcp-entra {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 1000px) {
    .home-mcp__grid { grid-template-columns: 1fr; gap: 36px; }
    .home-mcp__lead { max-width: none; }
    .mcp-app { max-width: 620px; }
  }
  @media (max-width: 700px) {
    .mcp-app__body { grid-template-columns: 1fr; min-height: 0; }
    .mcp-app__side { flex-direction: row; gap: 6px; padding: 10px; border-right: 0; border-bottom: 1px solid #e6e1d4; overflow: hidden; }
    .mcp-app__side-new { display: none; }
    .mcp-app__thread { padding: 14px; }
  }
  @media (max-width: 600px) {
    .home-mcp h2 { font-size: clamp(2.1rem, 9vw, 2.8rem); }
    .home-mcp__lead { font-size: 15px; }
    .home-mcp__list li { font-size: 14px; }
    .mcp-msg--you, .mcp-say { font-size: 13px; }
    .mcp-preview__row { grid-template-columns: 72px 1fr; gap: 9px; } .mcp-tool, .mcp-preview, .mcp-permit { margin-left: 0; } .mcp-say { grid-template-columns: 20px 1fr; gap: 8px; }
    .mcp-permit__btns { flex-wrap: wrap; }
  }
</style>

<script>
  // A cena: a pessoa pede, o Claude pensa (orb), responde, monta a prévia e
  // pede permissão — aí um cursor vai até "Permitir uma vez" e clica. Só depois
  // do clique entra a confirmação. Roda uma vez, quando a janela aparece.
  //
  // Nada disso existe sem JS ou com movimento reduzido: o orb e o cursor ficam
  // com [hidden] e a janela aparece inteira e legível.
  const janela = document.querySelector<HTMLElement>(".mcp-app");
  const thread = janela?.querySelector<HTMLElement>(".mcp-app__thread");
  const orb = janela?.querySelector<HTMLElement>("[data-orb]");
  const cursor = janela?.querySelector<HTMLElement>("[data-cursor]");
  const permitir = janela?.querySelector<HTMLElement>(".mcp-permit__btn:not(.is-primary)");
  const pedido = janela?.querySelector<HTMLElement>(".mcp-permit");

  if (janela && thread && orb && cursor && permitir && pedido && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
    thread.dataset.anim = "espera";
    const espere = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const cena = async () => {
      thread.dataset.anim = "entra";
      await espere(500);
      orb.hidden = false;           // o Claude pensando
      await espere(900);
      orb.hidden = true;            // some quando a resposta entra
      await espere(2200);           // prévia e pedido de permissão na tela

      const janelaRect = janela.getBoundingClientRect();
      const alvo = permitir.getBoundingClientRect();
      // entra pela borda de baixo à direita e vai até o botão
      cursor.style.setProperty("--x", `${janelaRect.width * 0.72}px`);
      cursor.style.setProperty("--y", `${janelaRect.height * 0.92}px`);
      cursor.hidden = false;
      await espere(60);
      cursor.style.setProperty("--x", `${alvo.left - janelaRect.left + alvo.width * 0.52}px`);
      cursor.style.setProperty("--y", `${alvo.top - janelaRect.top + alvo.height * 0.6}px`);
      await espere(820);
      cursor.classList.add("is-click");
      permitir.classList.add("is-press");
      await espere(200);
      cursor.classList.remove("is-click");
      permitir.classList.remove("is-press");
      await espere(220);
      pedido.classList.add("is-oculto");   // o pedido sai da conversa
      thread.classList.add("is-confirmado"); // e só agora entra o "está no ar"
      await espere(380);
      cursor.hidden = true;
    };

    const olho = new IntersectionObserver((entradas) => {
      if (!entradas.some((e) => e.isIntersecting)) return;
      olho.disconnect();
      cena();
    }, { threshold: 0.3 });
    olho.observe(janela);
  }
</script>
