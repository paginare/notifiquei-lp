---
/**
 * Hero das landings de tráfego (/comece/<tema>). Diferente do hero da home: quem
 * chega de anúncio precisa entender em 2 segundos que é automação de Instagram,
 * então a categoria vem escrita no topo, o título é menor e o produto aparece
 * rodando (comentário → resposta → direct) já na primeira tela.
 */
import Icon from "./HomeIcon.astro";

interface Props { titulo: string[]; lead: string; micro: string; }
const { titulo, lead, micro } = Astro.props;
---
<section class="lp-hero" aria-labelledby="hero-title">
  <div class="container lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="lp-hero__kicker"><Icon name="instagram" size={16} /> Automação de comentários e DMs no Instagram</p>
      <h1 id="hero-title">{titulo.map((linha) => <span>{linha}</span>)}</h1>
      <p class="lp-hero__lead" set:html={lead} />
      <a href="#planos" class="btn btn--brand btn--lg lp-hero__cta" data-home-cta="hero">Começar agora <Icon name="arrow" size={20} /></a>
      <p class="lp-hero__micro"><Icon name="check" size={15} /> {micro}</p>
      <div class="lp-hero__selos">
        <img src="/assets/meta-partner-white.svg" alt="Meta Business Partner" width="148" height="32" />
        <span aria-hidden="true"></span>
        <img src="/assets/tiktok-partner-white.svg" alt="TikTok Marketing Partner" width="100" height="32" />
      </div>
    </div>
    <div class="lp-hero__media">
      <video src="/assets/hero-ago26c.mp4" poster="/assets/lp/produto-poster.webp" width="640" height="800" data-autoplay muted loop playsinline preload="none" aria-label="Demonstração: alguém comenta “Quero o link” e recebe a resposta automática no direct"></video>
    </div>
  </div>
</section>

<style>
  .lp-hero { background: #24221f; color: var(--paper); padding: 96px 0 44px; } /* topo livra o nav fixo */
  .lp-hero__inner { display: grid; gap: 28px; align-items: center; }
  .lp-hero__kicker { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #ffb3cd; background: #ff1f6d1f; border: 1px solid #ff1f6d40; border-radius: var(--r-pill); padding: 7px 13px; }
  .lp-hero h1 { font-size: clamp(2.3rem, 1.5rem + 3.6vw, 4.2rem); line-height: .98; letter-spacing: -.045em; margin-top: 18px; }
  .lp-hero h1 > span { display: block; }
  .lp-hero h1 > span:last-child { color: #ff88b2; }
  .lp-hero__lead { font-size: 16px; line-height: 1.6; color: #e0d8ce; max-width: 460px; margin-top: 16px; }
  .lp-hero__lead :global(strong) { color: #fff6ef; font-weight: 600; }
  .lp-hero__cta { margin-top: 22px; --btn-bg: var(--brand-ink); border: 1px solid #ff79a547; }
  .lp-hero__micro { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 13px; color: var(--on-ink-soft); }
  .lp-hero__selos { display: flex; align-items: center; gap: 18px; margin-top: 22px; opacity: .92; }
  .lp-hero__selos img { height: 26px; width: auto; }
  .lp-hero__selos > span { height: 22px; width: 1px; background: #fff3; }
  /* O vídeo tem muita margem creme: o zoom deixa o celular (o produto) maior. */
  .lp-hero__media { justify-self: center; width: min(100%, 320px); overflow: hidden; border-radius: var(--r-lg); background: #f6f1e8; box-shadow: 0 24px 60px #0007; }
  .lp-hero__media video { display: block; width: 100%; height: auto; transform: scale(1.28); transform-origin: 50% 46%; }
  @media (min-width: 900px) {
    .lp-hero { padding: 128px 0 80px; }
    .lp-hero__inner { grid-template-columns: 1.15fr 1fr; gap: 56px; }
    .lp-hero__media { width: min(100%, 420px); }
    .lp-hero__lead { font-size: 18px; }
  }
</style>
