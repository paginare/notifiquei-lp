---
/**
 * Hero das landings de tráfego (/comece/<tema>). Quem chega de anúncio precisa
 * entender em 2 segundos o que é vendido, então o hero faz UMA coisa: título,
 * lead e um fluxo desenhado em HTML (comentário → resposta automática → DM com
 * link). Sem vídeo, sem foto, sem selo disputando espaço — os selos ficam na
 * faixa logo abaixo. Referência: mockup aprovado no WhatsApp em 24/09.
 */
import Icon from "./HomeIcon.astro";

interface Props { titulo: string[]; lead: string; micro: string; }
const { titulo, lead, micro } = Astro.props;
---
<section class="lp-hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="lp-hero__canais">
      <span><Icon name="instagram" size={16} /> Instagram</span>
      <i aria-hidden="true">•</i>
      <span><Icon name="tiktok" size={16} /> TikTok</span>
      <i aria-hidden="true">•</i>
      <b>No automático</b>
    </p>
    <h1 id="hero-title">{titulo.map((linha) => <span>{linha}</span>)}</h1>
    <p class="lp-hero__lead" set:html={lead} />

    <div class="lp-flow" role="img" aria-label="A Julia comenta “QUERO! Me manda o link?” no seu post e recebe na hora, na DM, a resposta automática com o link da sua oferta.">
      <div class="lp-flow__card">
        <div class="lp-flow__who"><span class="lp-flow__av">J</span><span><b>julia</b><small>comentou no seu post</small></span></div>
        <p class="lp-flow__bubble">QUERO! Me manda o link? 😍</p>
        <div class="lp-flow__icons"><Icon name="heart" size={14} /><Icon name="chat" size={14} /><Icon name="send" size={14} /></div>
      </div>
      <div class="lp-flow__bot">
        <img src="/assets/favicon.svg" alt="" width="40" height="40" />
        <small>Resposta automática</small>
      </div>
      <div class="lp-flow__card lp-flow__card--dm">
        <div class="lp-flow__who"><span class="lp-flow__av">J</span><span><b>julia</b><small>na sua DM</small></span></div>
        <p class="lp-flow__bubble lp-flow__bubble--eu">Oi, Julia! 😍 Aqui está o link da sua oferta:</p>
        <span class="lp-flow__link"><Icon name="link" size={13} /> seusite.com</span>
        <small class="lp-flow__auto"><Icon name="bolt" size={12} /> Enviado automaticamente</small>
      </div>
    </div>

    <div class="lp-hero__actions">
      <a href="#planos" class="btn btn--brand btn--lg lp-hero__cta" data-home-cta="hero">Começar agora <Icon name="arrow" size={20} /></a>
      <a href="#plataforma" class="home-text-link">Ver na prática <Icon name="diagonal" size={18} /></a>
    </div>
    <p class="lp-hero__micro"><Icon name="check" size={15} /> {micro}</p>
  </div>
</section>

<div class="lp-selos">
  <div class="container lp-selos__inner">
    <img src="/assets/meta-partner-white.svg" alt="Meta Business Partner" width="148" height="32" loading="lazy" />
    <img src="/assets/tiktok-partner-white.svg" alt="TikTok Marketing Partner" width="100" height="32" loading="lazy" />
  </div>
</div>

<style>
  .lp-hero { background: #1d1b19; color: var(--paper); padding: 92px 0 40px; } /* topo livra o nav fixo */
  .lp-hero .container { max-width: 760px; }
  .lp-hero__canais { display: flex; align-items: center; gap: 9px; font-size: 13px; color: #d9d0c6; }
  .lp-hero__canais span { display: inline-flex; align-items: center; gap: 6px; }
  .lp-hero__canais i { font-style: normal; color: #fff5; }
  .lp-hero__canais b { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: #ff88b2; font-weight: 700; }
  .lp-hero h1 { font-size: clamp(2.5rem, 1.6rem + 4vw, 4.4rem); line-height: .96; letter-spacing: -.045em; margin-top: 16px; }
  .lp-hero h1 > span { display: block; }
  .lp-hero h1 > span:last-child { color: #ff6fa3; }
  .lp-hero__lead { font-size: 16px; line-height: 1.55; color: #e0d8ce; max-width: 520px; margin-top: 14px; }
  .lp-hero__lead :global(strong) { color: #fff6ef; font-weight: 600; }

  /* Fluxo: post → bot → DM, sempre numa linha (é a explicação do produto). */
  .lp-flow { display: grid; grid-template-columns: 1fr 58px 1fr; align-items: center; gap: 4px; margin-top: 22px; }
  .lp-flow__card { background: #2a2623; border: 1px solid #ffffff1a; border-radius: 14px; padding: 10px; font-size: 11.5px; line-height: 1.35; min-width: 0; }
  .lp-flow__card--dm { border-color: #ff1f6d59; box-shadow: 0 0 0 3px #ff1f6d14; }
  .lp-flow__who { display: flex; align-items: center; gap: 7px; }
  .lp-flow__who b { display: block; font-size: 12px; }
  .lp-flow__who small { display: block; font-size: 10px; color: #b7aca0; }
  .lp-flow__av { flex: none; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, #f9ce34, #ee2a7b 55%, #6228d7); color: #fff; font-weight: 700; font-size: 11px; }
  .lp-flow__bubble { margin-top: 8px; background: #3a3531; border-radius: 12px; padding: 7px 9px; color: #fff; }
  .lp-flow__bubble--eu { background: #ff1f6d; }
  .lp-flow__icons { display: flex; gap: 10px; margin-top: 8px; color: #b7aca0; }
  .lp-flow__link { display: flex; align-items: center; gap: 5px; margin-top: 6px; background: #fff; color: #14100e; border-radius: 999px; padding: 5px 9px; font-weight: 600; font-size: 10.5px; white-space: nowrap; overflow: hidden; }
  .lp-flow__auto { display: flex; align-items: center; gap: 4px; margin-top: 7px; font-size: 9.5px; color: #ff88b2; }
  .lp-flow__bot { position: relative; display: grid; justify-items: center; gap: 5px; text-align: center; }
  .lp-flow__bot::before { content: ""; position: absolute; top: 20px; left: -6px; right: -6px; border-top: 2px dashed #ff1f6d99; z-index: 0; }
  .lp-flow__bot img { position: relative; z-index: 1; border-radius: 11px; box-shadow: 0 0 22px #ff1f6d66; }
  .lp-flow__bot small { font-size: 9px; line-height: 1.2; color: #d9d0c6; }

  .lp-hero__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 24px; }
  .lp-hero__cta { --btn-bg: var(--brand-ink); border: 1px solid #ff79a547; }
  .lp-hero__actions .home-text-link { color: var(--paper); }
  .lp-hero__micro { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 13px; color: var(--on-ink-soft); }

  .lp-selos { background: #1d1b19; border-top: 1px solid #ffffff14; }
  .lp-selos__inner { display: flex; justify-content: center; align-items: center; gap: 32px; padding-block: 18px; }
  .lp-selos img { height: 26px; width: auto; opacity: .85; }

  @media (min-width: 700px) {
    .lp-hero { padding: 128px 0 72px; }
    .lp-hero__lead { font-size: 18px; }
    .lp-flow { grid-template-columns: 1fr 90px 1fr; gap: 8px; margin-top: 30px; }
    .lp-flow__card { padding: 14px; font-size: 14px; border-radius: 18px; }
    .lp-flow__who b { font-size: 14px; }
    .lp-flow__who small { font-size: 12px; }
    .lp-flow__av { width: 30px; height: 30px; font-size: 13px; }
    .lp-flow__link { font-size: 12.5px; }
    .lp-flow__auto { font-size: 11px; }
    .lp-flow__bot img { width: 54px; height: 54px; }
    .lp-flow__bot::before { top: 27px; }
    .lp-flow__bot small { font-size: 11px; }
  }
</style>
