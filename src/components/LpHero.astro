---
/**
 * Hero das landings de tráfego (/comece/<tema>). Feedback do mentor (25/09): quem
 * chega de anúncio tem ~3 segundos e não lê — o hero tem que se explicar pela
 * imagem. Então: foto clara de gente real no celular, com o comentário ("QUERO o
 * link!") e a resposta automática no direct por cima. Fundo claro, pouco texto.
 * No celular a foto vem logo depois do título, antes do botão.
 */
import Icon from "./HomeIcon.astro";
import { eyebrowLp, type TemaLp } from "../data/lp-trafego";

interface Props { tema: TemaLp; micro: string; }
const { tema, micro } = Astro.props;
---
<section class="lp-hero" aria-labelledby="hero-title">
  <div class="container lp-hero__inner">
    <div class="lp-hero__copy">
      <p class="lp-hero__eyebrow">{eyebrowLp}</p>
      <h1 id="hero-title">{tema.titulo.map((linha) => <span>{linha}</span>)}</h1>
      <p class="lp-hero__lead" set:html={tema.lead} />
    </div>

    <figure class="lp-hero__media">
      <img src="/assets/creators/day-morning.webp" alt="Criadora sorrindo enquanto olha o celular" width="760" height="760" fetchpriority="high" />
      <div class="lp-hero__comment" aria-hidden="true">
        <span class="lp-hero__av">J</span>
        <span><small>julia comentou no seu post</small><b>QUERO o link! 😍</b></span>
      </div>
      <figcaption class="lp-hero__dm">
        <b>Te mandei tudo no direct 💌</b>
        <small><Icon name="check" size={13} /> Resposta automática do Notifiquei</small>
      </figcaption>
    </figure>

    <div class="lp-hero__actions">
      <div class="lp-hero__buttons">
        <a href="#planos" class="btn btn--brand btn--lg lp-hero__cta" data-home-cta="hero">{tema.cta} <Icon name="arrow" size={20} /></a>
        <a href="#plataforma" class="lp-hero__sec">{tema.ctaSecundario} <Icon name="diagonal" size={17} /></a>
      </div>
      <p class="lp-hero__micro"><Icon name="check" size={15} /> {micro}</p>
    </div>
  </div>
</section>

<style>
  .lp-hero { background: var(--paper); color: var(--ink); }
  .lp-hero__inner { display: grid; gap: 20px; padding-top: 104px; padding-bottom: 40px; }
  .lp-hero__eyebrow { font-size: 12px; font-weight: 600; color: var(--brand-ink); }
  .lp-hero h1 { font-size: clamp(2.3rem, 1.3rem + 4.4vw, 4.6rem); line-height: .98; letter-spacing: -.05em; margin-top: 10px; }
  .lp-hero h1 > span { display: block; }
  .lp-hero h1 > span:last-child { color: var(--brand-ink); }
  .lp-hero__lead { font-size: 15px; line-height: 1.55; color: var(--ink-soft); max-width: 480px; margin-top: 12px; }
  .lp-hero__lead :global(strong) { color: var(--ink); font-weight: 600; }

  /* A foto é o argumento: gente de verdade recebendo a resposta no direct. */
  .lp-hero__media { position: relative; margin: 0; border-radius: 26px; overflow: hidden; aspect-ratio: 1 / 1; box-shadow: 0 24px 60px #14100e24; }
  .lp-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; }
  .lp-hero__comment { position: absolute; top: 16px; left: 16px; right: 22%; display: flex; align-items: center; gap: 9px; padding: 10px 13px; background: #fffdfa; border-radius: 16px 16px 16px 4px; box-shadow: 0 10px 26px #14100e2e; transform: rotate(-2deg); }
  .lp-hero__av { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, #f9ce34, #ee2a7b 55%, #6228d7); color: #fff; font-weight: 700; font-size: 12px; }
  .lp-hero__comment small { display: block; font-size: 11px; color: #817472; }
  .lp-hero__comment b { display: block; font-size: 15px; font-weight: 600; }
  .lp-hero__dm { position: absolute; left: 16px; right: 16px; bottom: 16px; padding: 14px 18px; background: #ff1f6dee; color: #fff; border-radius: 18px 18px 4px 18px; box-shadow: 0 14px 34px #c90c5455; backdrop-filter: blur(4px); }
  .lp-hero__dm b { display: block; font-family: var(--font-display); font-size: 19px; letter-spacing: -.02em; line-height: 1.1; }
  .lp-hero__dm small { display: flex; align-items: center; gap: 5px; margin-top: 6px; font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; opacity: .92; }

  .lp-hero__buttons { display: flex; align-items: center; flex-wrap: wrap; gap: 18px; }
  .lp-hero__cta { --btn-bg: var(--brand-ink); }
  .lp-hero__sec { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: var(--ink); }
  .lp-hero__sec:hover { color: var(--brand-ink); }
  .lp-hero__micro { display: flex; align-items: center; gap: 7px; font-size: 12px; color: var(--ink-soft); margin-top: 12px; }
  .lp-hero__micro :global(svg) { color: var(--brand-ink); }

  @media (min-width: 900px) {
    .lp-hero__inner { grid-template-columns: 1fr 1fr; grid-template-areas: "copy media" "actions media"; column-gap: 72px; row-gap: 32px; align-content: center; min-height: 740px; padding-top: 132px; padding-bottom: 64px; }
    .lp-hero__copy { grid-area: copy; align-self: end; }
    .lp-hero__actions { grid-area: actions; align-self: start; }
    .lp-hero__media { grid-area: media; align-self: center; max-width: 540px; width: 100%; justify-self: end; border-radius: 32px; }
    .lp-hero__comment { top: 24px; left: 24px; padding: 13px 16px; }
    .lp-hero__comment b { font-size: 17px; }
    .lp-hero__dm { left: 24px; right: 24px; bottom: 24px; padding: 18px 22px; }
    .lp-hero__dm b { font-size: 27px; }
    .lp-hero__lead { font-size: 18px; margin-top: 20px; }
    .lp-hero__eyebrow { font-size: 13px; }
  }
</style>
