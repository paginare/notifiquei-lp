---
// Botão flutuante do WhatsApp. O clique vira Contact no pixel e na API de
// Conversões (ver Conversoes.astro, que escuta links wa.me) e um evento no
// PostHog. O número é o mesmo do rodapé e do FAQ: +55 12 3199-5949.
import { WPP } from "../data/home";

interface Props { texto: string; rotulo: string; }
const { texto, rotulo } = Astro.props;
const href = `${WPP}?text=${encodeURIComponent(texto)}`;
---

<a class="zap" href={href} target="_blank" rel="noopener" aria-label={rotulo} data-zap="flutuante">
  <svg viewBox="0 0 24 24" width="27" height="27" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.47-1.76-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z"
    />
    <path
      fill="currentColor"
      d="M12.04 2C6.6 2 2.17 6.43 2.17 11.87c0 1.74.46 3.44 1.32 4.94L2 22l5.34-1.4a9.85 9.85 0 0 0 4.7 1.2h.01c5.44 0 9.87-4.43 9.87-9.87 0-2.64-1.03-5.12-2.9-6.99A9.8 9.8 0 0 0 12.05 2Zm0 17.98h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.1.81.83-3.02-.2-.31a8.15 8.15 0 0 1-1.25-4.36c0-4.52 3.68-8.2 8.21-8.2a8.15 8.15 0 0 1 5.8 2.41 8.15 8.15 0 0 1 2.4 5.8c0 4.52-3.68 8.19-8.2 8.19Z"
    />
  </svg>
</a>

<style>
  .zap {
    position: fixed;
    right: clamp(14px, 2vw, 24px);
    bottom: calc(clamp(14px, 2vw, 24px) + env(safe-area-inset-bottom, 0px));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 10px 26px #12100e2e, 0 2px 6px #12100e1f;
    transition: transform .25s var(--ease-out), box-shadow .25s var(--ease-out);
  }
  .zap:hover { transform: translateY(-3px) scale(1.04); box-shadow: 0 16px 32px #12100e33; }
  .zap:active { transform: translateY(-1px) scale(.98); }
  .zap:focus-visible { outline: 3px solid #14100e; outline-offset: 3px; }
  /* Entra depois da primeira dobra, pra não competir com o CTA do hero. */
  .zap { opacity: 0; visibility: hidden; transform: translateY(12px) scale(.9); }
  .zap.is-on { opacity: 1; visibility: visible; transform: none; }
  @media (max-width: 600px) { .zap { width: 52px; height: 52px; } }
  @media (prefers-reduced-motion: reduce) {
    .zap, .zap:hover, .zap:active { transition: none; transform: none; }
  }
</style>

<script>
  // Só aparece depois que a pessoa passa do hero: no topo o CTA principal é o
  // "Começar grátis", e dois botões disputando atenção não ajudam ninguém.
  const zap = document.querySelector<HTMLAnchorElement>(".zap");
  if (zap) {
    const alternar = () => zap.classList.toggle("is-on", window.scrollY > window.innerHeight * 0.6);
    alternar();
    window.addEventListener("scroll", alternar, { passive: true });
  }
</script>
