---
import Logo from "./Logo.astro";
import LangSwitcher from "./LangSwitcher.astro";
import { LINKS_PT, type NavLink } from "../data/nav";
interface Props {
  lang?: "pt-BR" | "en" | "es";
  langLabel?: string;
  links?: NavLink[];
  entrar?: string;
  comecar?: string;
  comecarHref?: string; // entrar="" esconde o link de login (landings de tráfego)
}
const { lang = "pt-BR", langLabel, links = LINKS_PT, entrar = "Entrar", comecar = "Começar", comecarHref = "/#planos" } = Astro.props;
---
<header class="nav" id="siteNav">
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label="Notifiquei — início">
      <Logo height={24} />
    </a>

    <nav class="nav__links" aria-label="Navegação principal">
      {links.map((l) => l.itens ? (
        <div class="nav__grupo">
          <button type="button" class="nav__grupo-btn" aria-expanded="false">{l.label}<span class="nav__seta" aria-hidden="true"></span></button>
          <div class="nav__painel">
            {l.itens.map((i) => <a href={i.href} class="nav__sub"><b>{i.label}</b>{i.desc && <small>{i.desc}</small>}</a>)}
          </div>
        </div>
      ) : <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__cta">
      <LangSwitcher atual={lang} label={langLabel} />
      {entrar && <a href="https://app.notifiquei.com.br" class="nav__login">{entrar}</a>}
      <a href={comecarHref} class="btn btn--brand nav__start">{comecar}<span class="arr" aria-hidden="true">→</span></a>
      <button
        type="button"
        class="nav__burger"
        id="navBurger"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="navMobile"
      >
        <span class="nav__burger-box" aria-hidden="true">
          <span class="nav__burger-bar"></span>
        </span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" id="navMobile" hidden>
    <nav class="nav__mobile-nav" aria-label="Navegação principal (mobile)">
      {links.flatMap((l) => l.itens ? l.itens : [l]).map((l) => <a href={l.href} class="nav__mobile-link">{l.label}</a>)}
    </nav>
    <div class="nav__mobile-lang"><LangSwitcher atual={lang} label={langLabel} /></div>
    {entrar && <a href="https://app.notifiquei.com.br" class="nav__mobile-link nav__mobile-login">{entrar}</a>}
    <a href={comecarHref} class="btn btn--brand nav__mobile-start">{comecar}<span class="arr" aria-hidden="true">→</span></a>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: clamp(0.6rem, 1.5vw, 1.1rem);
    left: 0;
    right: 0;
    z-index: 100;
    pointer-events: none;
  }
  .nav__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 60px;
    padding-inline: 0.5rem 0.5rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid var(--line-soft);
    box-shadow: 0 1px 1px rgba(22,18,16,0.03);
    transition: box-shadow 0.4s var(--ease-out), border-color 0.4s var(--ease-out), background 0.4s var(--ease-out);
  }
  .nav.is-scrolled .nav__inner {
    box-shadow: var(--shadow-md);
    border-color: var(--line);
    background: color-mix(in srgb, var(--paper) 86%, transparent);
  }
  .nav__brand { padding-left: 1rem; }
  .nav__brand { color: var(--ink); display: inline-flex; }
  .nav__links {
    display: none;
    gap: 1.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    /* Sem isto os rótulos de duas palavras ("Como funciona", "vs ManyChat")
       quebram em duas linhas e a barra fica com cara de apertada. */
    white-space: nowrap;
  }
  .nav__links a {
    color: var(--ink-soft);
    transition: color 0.2s var(--ease-out);
    position: relative;
  }
  .nav__links a:hover { color: var(--ink); }
  .nav__cta { display: flex; align-items: center; gap: 0.6rem; white-space: nowrap; }
  .nav__login {
    display: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
    padding: 0.5rem 0.25rem;
  }
  .nav__login:hover { color: var(--brand-ink); }
  .nav__start { padding: 0.6rem 1.15rem; font-size: 0.9rem; }

  /* ── Grupo com painel (desktop): abre no hover, no foco e no clique ── */
  .nav__grupo { position: relative; display: flex; align-items: center; }
  .nav__grupo-btn { display: inline-flex; align-items: center; gap: 6px; padding: 0; border: 0; background: none; font: inherit; color: inherit; cursor: pointer; }
  .nav__seta { width: 7px; height: 7px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: translateY(-2px) rotate(45deg); transition: transform .2s; }
  .nav__painel {
    position: absolute; top: 100%; left: -18px; margin-top: 14px; min-width: 300px; padding: 8px;
    display: grid; gap: 2px; background: var(--paper); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 18px 40px #14100e1f; opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .18s, transform .18s, visibility .18s; white-space: normal;
  }
  /* ponte invisível pro mouse não "cair" no vão entre o botão e o painel */
  .nav__painel::before { content: ""; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
  .nav__grupo:hover .nav__painel, .nav__grupo:focus-within .nav__painel, .nav__grupo.is-open .nav__painel { opacity: 1; visibility: visible; transform: none; }
  .nav__grupo:hover .nav__seta, .nav__grupo.is-open .nav__seta { transform: translateY(1px) rotate(225deg); }
  .nav__links .nav__sub { display: grid; gap: 2px; padding: 10px 12px; border-radius: 10px; color: var(--ink) !important; }
  .nav__links .nav__sub:hover { background: #14100e0a; }
  .nav__sub b { font-size: 13px; font-weight: 700; }
  .nav__sub small { font-size: 12px; font-weight: 500; color: var(--ink-soft); }

  /* ── Botão hambúrguer (mobile) ── */
  .nav__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: 0.25rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    border-radius: var(--r-md, 12px);
  }
  .nav__burger-box {
    position: relative;
    width: 22px;
    height: 2px;
  }
  .nav__burger-bar,
  .nav__burger-bar::before,
  .nav__burger-bar::after {
    position: absolute;
    left: 0;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s var(--ease-out), opacity 0.2s var(--ease-out);
  }
  .nav__burger-bar { top: 0; }
  .nav__burger-bar::before { content: ""; top: -7px; }
  .nav__burger-bar::after { content: ""; top: 7px; }
  .nav.is-open .nav__burger-bar { background: transparent; }
  .nav.is-open .nav__burger-bar::before { transform: translateY(7px) rotate(45deg); }
  .nav.is-open .nav__burger-bar::after { transform: translateY(-7px) rotate(-45deg); }

  /* ── Painel mobile ── */
  .nav__mobile {
    pointer-events: auto;
    margin-top: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--r-lg, 20px);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav__mobile[hidden] { display: none; }
  .nav__mobile-nav { display: flex; flex-direction: column; }
  .nav__mobile-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.85rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--ink);
    border-radius: var(--r-md, 12px);
  }
  .nav__mobile-link:hover,
  .nav__mobile-link:focus-visible { background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .nav__mobile-lang { padding: 0.35rem 0.85rem 0.15rem; }
  .nav__mobile-login { color: var(--ink-soft); }
  .nav__mobile-start {
    justify-content: center;
    min-height: 48px;
    margin-top: 0.35rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav__mobile:not([hidden]) { animation: navMobileIn 0.22s var(--ease-out); }
    @keyframes navMobileIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }

  @media (min-width: 1120px) {
    .nav__links { display: flex; }
    .nav__cta > .lang { display: block; }
    .nav__login { display: inline-block; }
    .nav__burger { display: none; }
    .nav__mobile { display: none; }
  }
</style>

<script>
  const nav = document.getElementById("siteNav");
  const burger = document.getElementById("navBurger");
  const panel = document.getElementById("navMobile");

  if (nav && burger && panel) {
    const setOpen = (open: boolean) => {
      burger.setAttribute("aria-expanded", String(open));
      burger.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
      nav.classList.toggle("is-open", open);
      if (open) {
        panel.hidden = false;
      } else {
        panel.hidden = true;
      }
    };

    burger.addEventListener("click", () => {
      setOpen(burger.getAttribute("aria-expanded") !== "true");
    });

    // fecha ao clicar num link
    panel.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );

    // ESC fecha
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) setOpen(false);
    });

    // clique fora fecha
    document.addEventListener("click", (e) => {
      if (
        nav.classList.contains("is-open") &&
        e.target instanceof Node &&
        !nav.contains(e.target)
      ) {
        setOpen(false);
      }
    });

    // grupos do menu: clique abre/fecha (teclado e toque); clique fora fecha
    document.querySelectorAll<HTMLElement>(".nav__grupo").forEach((g) => {
      const btn = g.querySelector<HTMLButtonElement>(".nav__grupo-btn");
      btn?.addEventListener("click", () => {
        const aberto = !g.classList.contains("is-open");
        g.classList.toggle("is-open", aberto);
        btn.setAttribute("aria-expanded", String(aberto));
      });
      document.addEventListener("click", (e) => {
        if (e.target instanceof Node && !g.contains(e.target)) { g.classList.remove("is-open"); btn?.setAttribute("aria-expanded", "false"); }
      });
    });

    // volta ao desktop fecha o menu
    const mq = window.matchMedia("(min-width: 860px)");
    mq.addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<script is:inline>
  // PostHog: track nav login and start CTA clicks
  document.addEventListener('DOMContentLoaded', function () {
    var loginLinks = document.querySelectorAll('.nav__login, .nav__mobile-login');
    loginLinks.forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('nav_login_clicked');
      });
    });
  });
</script>
