---
import Icon from "./HomeIcon.astro";
import HomeConversation from "./HomeConversation.astro";
import { FREE } from "../data/home";
import { type CopyHome } from "../i18n/home";

interface Props { t: CopyHome["hero"]; conversa: CopyHome["conversa"]; imagensConversa?: string[]; }
const { t, conversa, imagensConversa } = Astro.props;
---

<section class="home-hero" aria-labelledby="hero-title">
  <div class="home-hero__photo">
    <img
      src="/assets/home/creator-hero-v3.webp"
      alt={t.fotoAlt}
      width="1120"
      height="1400"
      fetchpriority="high"
    />
  </div>
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <div class="home-hero__channels">
        <span><Icon name="instagram" size={17} /> Instagram</span>
        <span class="home-hero__channel-dot" aria-hidden="true"></span>
        <span><Icon name="tiktok" size={17} /> TikTok</span>
        <span class="home-hero__channel-note">{t.canais.nota}</span>
      </div>
      <h1 id="hero-title">{t.titulo.map((linha) => <span>{linha}</span>)}</h1>
      <p class="home-hero__lead" set:html={t.lead} />
      <div class="home-actions hero__actions">
        <a href="#planos" class="btn btn--brand btn--lg br-only" data-home-cta="hero">
          {t.ctaBr} <Icon name="arrow" size={21} />
        </a>
        <a href="#planos" class="btn btn--brand btn--lg intl-only" data-home-cta="hero">
          {t.ctaIntl} <Icon name="arrow" size={21} />
        </a>
        <a href="#plataforma" class="home-text-link">{t.verNaPratica} <Icon name="diagonal" size={18} /></a>
      </div>
      <p class="home-hero__micro br-only"><Icon name="check" size={15} /> {t.microBr}</p>
      <p class="home-hero__micro intl-only"><Icon name="check" size={15} /> {t.microIntl}</p>
      <HomeConversation t={conversa} imagens={imagensConversa} />
      <div class="home-hero__trust">
        <img src="/assets/meta-partner-white.svg" alt="Meta Business Partner" width="148" height="32" />
        <span aria-hidden="true"></span>
        <img src="/assets/tiktok-partner-white.svg" alt="TikTok Marketing Partner" width="100" height="32" />
      </div>
    </div>
  </div>
</section>
