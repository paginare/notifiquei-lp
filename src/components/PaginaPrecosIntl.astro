---
/** Corpo de /en/pricing e /es/precios (30/09/2026): cartões da home + tabela + perguntas. */
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import Icon from "./HomeIcon.astro";
import HomePricing from "./HomePricing.astro";
import ZapFlutuante from "./ZapFlutuante.astro";
import { copyHome, marcar } from "../i18n/home";
import { precosIntl } from "../data/precos-intl";
import { en as antigoEn } from "../i18n/en";
import { es as antigoEs } from "../i18n/es";
import { WPP } from "../data/home";

interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const t = copyHome(lang);
const c = precosIntl[lang];
const rodape = (lang === "en" ? antigoEn : antigoEs).footer;
const entrar = (lang === "en" ? antigoEn : antigoEs).nav.entrar;
const SIM = lang === "en" ? "Yes" : "Sí";
const NAO = "No";
---
<div class="home-page pagina-clara pg-precos">
  <a href="#conteudo" class="home-skip">{t.meta.skip}</a>
  <Nav links={t.nav} lang={lang} langLabel={t.meta.navLangLabel} comecar={t.meta.navComecar} comecarHref="#planos" entrar={entrar} />
  <main id="conteudo">
    <HomePricing t={t.planos} lang={lang} src={`precos-${lang}`} />

    <section class="home-section pr-tabela" id="comparar">
      <div class="container">
        <div class="home-centered-heading">
          <span class="home-kicker"><Icon name="chart" size={17} /> {c.kicker}</span>
          <h2 set:html={marcar(c.titulo)} />
        </div>
        <div class="cmp" tabindex="0" aria-label={c.kicker}>
          <table>
            <thead><tr><th scope="col"><span class="sr-only">—</span></th>{c.planos.map((p) => <th scope="col">{p}</th>)}</tr></thead>
            <tbody>
              {c.grupos.map((g) => (
                <>
                  <tr class="cmp__grupo"><th colspan={c.planos.length + 1} scope="colgroup">{g.titulo}</th></tr>
                  {g.linhas.map((l) => (
                    <tr>
                      <th scope="row">{l.recurso}</th>
                      {l.valores.map((v) => (
                        <td>{v === true ? <span class="cmp__sim"><Icon name="check" size={17} /><span class="sr-only">{SIM}</span></span> : v === false ? <span class="cmp__nao">—<span class="sr-only">{NAO}</span></span> : v}</td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
        <p class="pr-nota">{c.nota}</p>
      </div>
    </section>

    <section class="home-section home-faq" id="faq">
      <div class="container home-faq__grid">
        <div class="home-faq__intro">
          <span class="home-kicker">{t.faq.kicker}</span>
          <h2 set:html={marcar(c.faqTitulo)} />
          <p>{t.faq.lead}</p>
          <a href={WPP} class="home-text-link">{t.faq.cta} <Icon name="diagonal" size={20} /></a>
        </div>
        <div class="faq">
          {c.faqs.map((f) => (
            <details class="faq__item" name="faq">
              <summary class="faq__q">{f.q}<span class="faq__icon" aria-hidden="true"></span></summary>
              <div class="faq__a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer {...rodape} />
  <ZapFlutuante texto={t.zapTexto} rotulo={t.zapRotulo} />
</div>

<script>
  import { initHomeMotion } from "../scripts/home-motion";
  initHomeMotion();
  const lang = document.documentElement.lang;
  document.getElementById("plans-grid")?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const cta = event.target.closest(".plan__cta");
    if (!cta) return;
    const planName = cta.closest(".plan")?.querySelector(".plan__name")?.textContent?.trim();
    const annual = document.querySelector("#billtoggle [data-cycle='a']")?.getAttribute("aria-pressed") === "true";
    (window as any).posthog?.capture?.("plan_cta_clicked", { plan_name: planName, billing_cycle: annual ? "annual" : "monthly", page: `precos_${lang}` });
  });
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href*="buy.stripe.com"]');
    const language = link?.href.match(/nqlang_([a-zA-Z-]+)/);
    if (language) document.cookie = `nq_lang=${language[1]}; path=/; max-age=3600; SameSite=Lax`;
  }, true);
</script>

<style>
  .pg-precos :global(.home-pricing) { padding-top: 150px; }
  .pr-tabela { background: #eee7dc; }
  .pr-nota { text-align: center; font-size: 13px; color: var(--ink-soft); margin-top: 20px; }
  @media (max-width: 700px) { .pg-precos :global(.home-pricing) { padding-top: 110px; } }
</style>
