---
interface Props {
  bg?: "paper" | "paper2";
  eyebrow?: string;
  title?: string; // pode conter <br>
  lead?: string;
  id?: string;
  platform?: { tag: string; title: string; body: string }[];
  precoNota?: string;      // linha "A partir de …" (a versão PT tem variantes por moeda)
  mock?: Record<string, string>; // rótulos dentro dos mockups
}
const {
  bg = "paper",
  eyebrow = "Dentro da plataforma",
  title = "Um painel simples pra criar, acompanhar<br class='br-r' /> e <span class='hl'>ajustar suas automações</span>.",
  lead = "Nada de painel confuso com mil abas. Tudo que você precisa, onde você espera encontrar — e por um preço que cabe no bolso.",
  id = "plataforma",
  platform,
  precoNota,
  mock = {},
} = Astro.props;

const PLATFORM_PT = [
  { tag: "Criação guiada", title: "Escolha o gatilho, ele faz o resto.", body: "Escolhe o gatilho: comentário, story ou palavra na DM. Diz o que a pessoa recebe e confere tudo num celular, igual fica no Instagram de verdade. Editor visual? Segue ali, a um clique." },
  { tag: "Números em tempo real", title: "Veja cada clique acontecendo.", body: "Quantos DMs respondidos, quantos leads receberam o link, quantos clicaram. Dados simples que respondem “tá engajando?”." },
  { tag: "Sorteios pelos comentários", title: "Sorteie sem garimpar comentário.", body: "Quem comenta a palavra entra sozinho na lista. Você clica em sortear e ele mostra os ganhadores — sem planilha, sem print, sem contar na mão." },
  { tag: "Links e cliques", title: "Troque o link sem mexer nas automações.", body: "Cada link ganha um apelido. Mudou o destino? Você troca num lugar só e toda automação já manda o novo — e vê quantos clicaram em cada uma." },
];
const cards = platform ?? PLATFORM_PT;

// Rótulos dos mockups. Padrão em português; /en e /es passam os seus.
const M = {
  relatorios: "notifiquei · relatórios", sorteios: "notifiquei · sorteios", links: "notifiquei · links",
  dmsRespondidos: "DMs respondidos", linksClicados: "Links clicados", taxaResposta: "Taxa de resposta",
  vsSemana: "vs. semana passada", tempoMedio: "tempo médio · 3s",
  comentou: "Comentou", participantes: "participantes", ganhou: "ganhou", sortear: "Sortear",
  usadoEm: "Usado em", automacoes: "7 automações",
  trocaAqui: "— troca aqui e todas passam a mandar o novo.", trocar: "trocar",
  cliquesSemana: "847 cliques esta semana",
  comentarioDm: "Comentário → DM", respostaStory: "Resposta de story", quebraGelo: "Quebra Gelo",
  ...mock,
};
---
<section class={`section ${bg === "paper2" ? "section--paper2" : ""}`} id={id}>
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2 set:html={title} />
      <p class="lead">{lead}</p>
      {precoNota ? <p class="pshow__price" set:html={precoNota} /> : <><p class="pshow__price br-only"><strong>A partir de R$ 99/mês</strong> · contatos ilimitados · garantia de 7 dias · <a href="#comparativo">ver comparação</a></p>
      <p class="pshow__price intl-only"><strong><span data-cur="USD">A partir de $19/mês</span><span data-cur="EUR">A partir de €18/mês</span></strong> · contatos ilimitados · garantia de 7 dias · <a href="#planos">ver planos</a></p></>}
    </div>
    <div class="platform">
      <!-- 1 · Montagem visual -->
      <article class="prow reveal">
        <div class="prow__copy">
          <span class="eyebrow pcard__tag">{cards[0].tag}</span>
          <h3 class="pcard__title">{cards[0].title}</h3>
          <p class="pcard__body">{cards[0].body}</p>
        </div>
        <div class="prow__art" aria-hidden="true">
          <video
            class="flowvid"
            src="/assets/flow-build-ago26b.mp4"
            poster="/assets/flow-build-ago26b-poster.webp"
            data-autoplay muted loop playsinline preload="none"
          ></video>
        </div>
      </article>

      <!-- 2 · Números em tempo real -->
      <article class="prow prow--rev reveal">
        <div class="prow__copy">
          <span class="eyebrow pcard__tag">{cards[1].tag}</span>
          <h3 class="pcard__title">{cards[1].title}</h3>
          <p class="pcard__body">{cards[1].body}</p>
        </div>
        <div class="prow__art" aria-hidden="true">
          <div class="ui ui--stats">
            <div class="ui__bar"><span class="ui__dots"><i></i><i></i><i></i></span><span class="ui__url">{M.relatorios}</span></div>
            <div class="dash">
              <div class="dash__cards">
                <div class="scard">
                  <div class="scard__head"><span>{M.dmsRespondidos}</span><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                  <b class="scard__num">1.284</b>
                  <span class="scard__delta up">+18% {M.vsSemana}</span>
                </div>
                <div class="scard">
                  <div class="scard__head"><span>{M.linksClicados}</span><svg viewBox="0 0 24 24"><path d="m9 9 5 12 1.8-5.2L21 14z"/><path d="M7.2 2.2 8 5.1M5.1 8 2.2 7.2M14 4.1 12 6M6 12l-1.9 2"/></svg></div>
                  <b class="scard__num">847</b>
                  <span class="scard__delta up">+9% {M.vsSemana}</span>
                </div>
                <div class="scard scard--brand">
                  <div class="scard__head"><span>{M.taxaResposta}</span><svg viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg></div>
                  <b class="scard__num">98%</b>
                  <span class="scard__delta up">{M.tempoMedio}</span>
                </div>
              </div>
              <svg class="spark" viewBox="0 0 320 64" preserveAspectRatio="none">
                <defs><linearGradient id="sg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--brand)" stop-opacity="0.22"/><stop offset="1" stop-color="var(--brand)" stop-opacity="0"/></linearGradient></defs>
                <path d="M0,50 C40,46 60,28 95,31 C130,34 150,12 190,17 C230,22 250,6 320,5 L320,64 L0,64 Z" fill="url(#sg)"/>
                <path d="M0,50 C40,46 60,28 95,31 C130,34 150,12 190,17 C230,22 250,6 320,5" fill="none" stroke="var(--brand)" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
        </div>
      </article>

      <!-- 3 · Sorteios pelos comentários -->
      <article class="prow reveal">
        <div class="prow__copy">
          <span class="eyebrow pcard__tag">{cards[2].tag}</span>
          <h3 class="pcard__title">{cards[2].title}</h3>
          <p class="pcard__body">{cards[2].body}</p>
        </div>
        <div class="prow__art" aria-hidden="true">
          <div class="ui ui--draw">
            <div class="ui__bar"><span class="ui__dots"><i></i><i></i><i></i></span><span class="ui__url">{M.sorteios}</span></div>
            <div class="draw">
              <div class="draw__head">
                <span class="draw__kw">{M.comentou} <b>“EUQUERO”</b></span>
                <span class="draw__count"><b>1.842</b> {M.participantes}</span>
              </div>
              <div class="draw__winners">
                <div class="dw"><span class="dw__pos">1</span><span class="ava ava--sm" data-ava="mariana"></span><b>mariana.fit</b><span class="dw__tag">{M.ganhou}</span></div>
                <div class="dw"><span class="dw__pos">2</span><span class="ava ava--sm" data-ava="joao"></span><b>joao.suplementos</b><span class="dw__tag">ganhou</span></div>
                <div class="dw dw--ghost"><span class="dw__pos">3</span><span class="ava ava--sm" data-ava="bia"></span><b>bia.estetica</b><span class="dw__tag">ganhou</span></div>
              </div>
              <div class="draw__btn">{M.sortear} <span class="draw__btn-ic">🎲</span></div>
            </div>
          </div>
        </div>
      </article>

      <!-- 4 · Links dinâmicos + cliques por automação -->
      <article class="prow prow--rev reveal">
        <div class="prow__copy">
          <span class="eyebrow pcard__tag">{cards[3].tag}</span>
          <h3 class="pcard__title">{cards[3].title}</h3>
          <p class="pcard__body">{cards[3].body}</p>
        </div>
        <div class="prow__art" aria-hidden="true">
          <div class="ui ui--links">
            <div class="ui__bar"><span class="ui__dots"><i></i><i></i><i></i></span><span class="ui__url">{M.links}</span></div>
            <div class="lks">
              <div class="lk">
                <span class="lk__alias">{"{{link:promo}}"}</span>
                <span class="lk__url">loja.com/black-friday</span>
                <span class="lk__edit">{M.trocar}</span>
              </div>
              <p class="lks__hint">{M.usadoEm} <b>{M.automacoes}</b> {M.trocaAqui}</p>
              <div class="lkbars">
                <div class="lkbar"><span class="lkbar__n">{M.comentarioDm}</span><i style="--w:100%"></i><b>512</b></div>
                <div class="lkbar"><span class="lkbar__n">{M.respostaStory}</span><i style="--w:52%"></i><b>266</b></div>
                <div class="lkbar"><span class="lkbar__n">{M.quebraGelo}</span><i style="--w:13%"></i><b>69</b></div>
              </div>
              <p class="lks__foot">{M.cliquesSemana}</p>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .pshow__price { margin-top: 1.1rem; font-size: 0.95rem; color: var(--ink-soft); }
  .pshow__price strong { color: var(--brand-ink); font-weight: 800; }
  .pshow__price a { color: var(--brand-ink); font-weight: 700; border-bottom: 1px solid color-mix(in srgb, var(--brand) 30%, transparent); }
  .platform { display: flex; flex-direction: column; gap: clamp(3rem, 6vw, 5.5rem); margin-top: 3.5rem; }
  .prow { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
  .prow > * { min-width: 0; }
  .pcard__tag { color: var(--brand-ink); }
  .pcard__title { font-size: clamp(1.45rem, 1.1rem + 1.4vw, 2rem); margin-top: 0.9rem; }
  .pcard__body { margin-top: 0.8rem; color: var(--ink-soft); font-size: 1rem; max-width: 30rem; }
  @media (min-width: 880px) {
    .prow { grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 5vw, 4.5rem); }
    .prow--rev .prow__copy { order: 2; }
    .prow--rev .prow__art { order: 1; }
  }

  /* chrome comum dos mockups (double-bezel) */
  .ui { background: linear-gradient(180deg, var(--paper-2), var(--paper-3)); border: 1px solid var(--line); border-radius: var(--r-xl); padding: 7px; box-shadow: var(--shadow-lg); max-width: 100%; overflow: hidden; --ok: #1B9A5F; --purple: #7C3AED; }
  .ui__bar { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.85rem; }
  .ui__dots { display: inline-flex; gap: 5px; }
  .ui__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--paper-3); border: 1px solid var(--line); }
  .ui__url { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.01em; }
  .ui > :not(.ui__bar) { background: var(--card); border-radius: calc(var(--r-xl) - 7px); box-shadow: inset 0 1px 0 rgba(255,255,255,0.85); }

  /* 1 · criação guiada (vídeo: assistente por gatilho + prévia ao vivo do Instagram) */
  .flowvid { width: 100%; height: auto; display: block; aspect-ratio: 1280 / 960; border-radius: var(--r-lg); border: 1px solid var(--line); box-shadow: var(--shadow-lg); background: var(--paper-2); }

  /* 2 · dashboard */
  .ui--stats .dash { padding: 0.85rem; }
  .dash__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; }
  .scard { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 0.7rem 0.75rem; box-shadow: var(--shadow-sm); }
  .scard--brand { border-color: color-mix(in srgb, var(--brand) 35%, var(--line)); background: linear-gradient(180deg, var(--brand-wash), var(--card)); }
  .scard__head { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; }
  .scard__head span { font-size: 0.66rem; font-weight: 600; color: var(--ink-soft); line-height: 1.2; }
  .scard__head svg { flex: none; width: 14px; height: 14px; fill: none; stroke: var(--ink-faint); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .scard--brand .scard__head svg { stroke: var(--brand-ink); }
  .scard__num { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.7rem; letter-spacing: -0.03em; margin-top: 0.35rem; line-height: 1; }
  .scard--brand .scard__num { color: var(--brand-ink); }
  .scard__delta { font-size: 0.6rem; color: var(--ink-faint); }
  .scard__delta.up { color: var(--ok); }
  .ui--stats .spark { display: block; width: 100%; height: 64px; margin-top: 0.85rem; }

  /* avatares (usados no mockup de sorteio) */
  .ava { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--paper-3); background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px var(--line); }
  .ava--sm { width: 26px; height: 26px; }
  .ava[data-ava="mariana"] { background-image: url("/assets/avatars/mariana.webp"); }
  .ava[data-ava="joao"] { background-image: url("/assets/avatars/joao.webp"); }
  .ava[data-ava="bia"] { background-image: url("/assets/avatars/bia.webp"); }

  /* 3 · sorteio */
  .ui--draw .draw { padding: 0.85rem; }
  .draw__head { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap; padding-bottom: 0.75rem; border-bottom: 1px solid var(--line-soft); }
  .draw__kw { font-size: 0.78rem; color: var(--ink-soft); }
  .draw__kw b { color: var(--brand-ink); font-weight: 800; }
  .draw__count { font-size: 0.72rem; color: var(--ink-faint); }
  .draw__count b { font-family: var(--font-display); font-size: 1.05rem; color: var(--ink); letter-spacing: -0.02em; margin-right: 0.25em; }
  .draw__winners { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.75rem; }
  .dw { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.6rem; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-sm); min-width: 0; }
  .dw b { font-size: 0.78rem; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dw--ghost { opacity: 0.45; }
  .dw__pos { flex: none; width: 18px; height: 18px; display: grid; place-items: center; border-radius: 50%; background: var(--paper-3); color: var(--ink-faint); font-size: 0.6rem; font-weight: 800; }
  .dw__tag { flex: none; font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--brand-ink); background: var(--brand-wash); padding: 0.2rem 0.5rem; border-radius: var(--r-pill); }
  .draw__btn { display: flex; align-items: center; justify-content: center; gap: 0.4em; margin-top: 0.8rem; padding: 0.6rem; border-radius: 12px; background: var(--brand); color: #fff; font-size: 0.8rem; font-weight: 700; }
  .draw__btn-ic { font-size: 0.9em; }

  /* 4 · links dinâmicos + cliques */
  .ui--links .lks { padding: 0.85rem; }
  .lk { display: flex; align-items: center; gap: 0.55rem; padding: 0.6rem 0.7rem; background: var(--card); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow-sm); min-width: 0; }
  .lk__alias { flex: none; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; color: var(--brand-ink); background: var(--brand-wash); padding: 0.22rem 0.45rem; border-radius: 7px; }
  .lk__url { flex: 1; min-width: 0; font-size: 0.74rem; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lk__edit { flex: none; font-size: 0.65rem; font-weight: 700; color: var(--ink-faint); border: 1px solid var(--line); padding: 0.2rem 0.5rem; border-radius: var(--r-pill); }
  .lks__hint { margin-top: 0.6rem; font-size: 0.72rem; color: var(--ink-faint); line-height: 1.4; }
  .lks__hint b { color: var(--ink); font-weight: 700; }
  .lkbars { display: flex; flex-direction: column; gap: 0.5rem; margin-top: 0.85rem; }
  .lkbar { display: grid; grid-template-columns: 8.5rem 1fr auto; align-items: center; gap: 0.6rem; }
  .lkbar__n { font-size: 0.72rem; color: var(--ink-soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lkbar i { height: 8px; border-radius: var(--r-pill); background: var(--paper-3); position: relative; overflow: hidden; }
  .lkbar i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: var(--r-pill); background: var(--brand); }
  .lkbar b { font-family: var(--font-display); font-size: 0.82rem; letter-spacing: -0.02em; }
  .lks__foot { margin-top: 0.8rem; padding-top: 0.7rem; border-top: 1px solid var(--line-soft); font-size: 0.7rem; color: var(--ink-faint); }
  @media (max-width: 420px) { .lkbar { grid-template-columns: 6.5rem 1fr auto; } }
</style>
