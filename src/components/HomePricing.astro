---
import { plans, FREE } from "../data/home";
import { intlHref, mensalNoAnual, totalAnual } from "../i18n/planos";
const SRC = "home";
---
    <section class="home-section home-pricing" id="planos">
      <div class="container">
        <div class="section-head section-head--center reveal">
          <span class="eyebrow">Planos</span>
          <h2>Sua audiência cresce.<br /> <span class="hl">Seu preço continua fixo.</span></h2>
          <p class="lead br-only">Escolha o plano que acompanha o seu momento. Contatos ilimitados em todos eles, sem surpresas na fatura.</p>
          <p class="lead intl-only">Escolha o plano que acompanha o seu momento. Contatos ilimitados e preço fixo, sem surpresas na fatura.</p>
          <p class="plans__note"><strong>2 em 1:</strong> cada conta já conecta <strong>Instagram + TikTok</strong> no mesmo plano — automatize os dois sem pagar a mais.</p>
          <div class="billtoggle reveal" id="billtoggle" role="group" aria-label="Ciclo de cobrança">
            <button type="button" class="billtoggle__opt" data-cycle="m" aria-pressed="false">Mensal</button>
            <button type="button" class="billtoggle__opt is-on" data-cycle="a" aria-pressed="true">Anual <span class="billtoggle__save">2 meses de economia</span></button>
          </div>
        </div>
        <div class="plans" id="plans-grid">
          {plans.map((p, i) => (
            <article
              class={`plan reveal ${p.featured ? "plan--featured" : ""} ${p.mercado === "br" ? "br-only" : ""} ${p.mercado === "intl" ? "intl-only" : ""}`}
              style={`--reveal-delay:${i * 90}ms`}
            >
              {p.featured && <span class="plan__badge">Mais popular</span>}
              <h3 class="plan__name">{p.name}</h3>
              <p class="plan__blurb">{p.blurb}</p>
              {/* As três moedas saem no HTML; o CSS mostra a do país (ver global.css). */}
              {p.price && (
                <>
                  <p class="plan__price" data-cur="BRL"><span class="plan__cur">R$</span><span class="plan__amount" data-m={p.price} data-a={mensalNoAnual(p.price)}>{mensalNoAnual(p.price)}</span><span class="plan__per">/mês</span></p>
                  <p class="plan__bill" data-cur="BRL" data-bill={`cobrado R$ ${totalAnual(p.price).toLocaleString("pt-BR")}/ano`}>{`cobrado R$ ${totalAnual(p.price).toLocaleString("pt-BR")}/ano`}</p>
                  <a href={`${p.hrefA}?src=${SRC}`} data-href-m={`${p.hrefM}?src=${SRC}`} data-href-a={`${p.hrefA}?src=${SRC}`} class={`btn ${p.featured ? "btn--brand" : "btn--ghost"} plan__cta br-only`}>{p.cta}<span class="arr" aria-hidden="true">→</span></a>
                </>
              )}
              {p.usd && (
                <>
                  <p class="plan__price" data-cur="USD"><span class="plan__cur">$</span><span class="plan__amount" data-m={p.usd} data-a={mensalNoAnual(p.usd)}>{mensalNoAnual(p.usd)}</span><span class="plan__per">/mês</span></p>
                  <p class="plan__price" data-cur="EUR"><span class="plan__cur">€</span><span class="plan__amount" data-m={p.eur} data-a={mensalNoAnual(p.eur!)}>{mensalNoAnual(p.eur!)}</span><span class="plan__per">/mês</span></p>
                  <p class="plan__bill" data-cur="USD" data-bill={`cobrado $${totalAnual(p.usd).toLocaleString("en-US")}/ano`}>{`cobrado $${totalAnual(p.usd).toLocaleString("en-US")}/ano`}</p>
                  <p class="plan__bill" data-cur="EUR" data-bill={`cobrado €${totalAnual(p.eur!).toLocaleString("pt-BR")}/ano`}>{`cobrado €${totalAnual(p.eur!).toLocaleString("pt-BR")}/ano`}</p>
                  <a href={intlHref(p.slug, "USD", "a", "pt-BR")} data-href-m={intlHref(p.slug, "USD", "m", "pt-BR")} data-href-a={intlHref(p.slug, "USD", "a", "pt-BR")} data-cur="USD" class={`btn ${p.featured ? "btn--brand" : "btn--ghost"} plan__cta intl-only`}>{p.cta}<span class="arr" aria-hidden="true">→</span></a>
                  <a href={intlHref(p.slug, "EUR", "a", "pt-BR")} data-href-m={intlHref(p.slug, "EUR", "m", "pt-BR")} data-href-a={intlHref(p.slug, "EUR", "a", "pt-BR")} data-cur="EUR" class={`btn ${p.featured ? "btn--brand" : "btn--ghost"} plan__cta intl-only`}>{p.cta}<span class="arr" aria-hidden="true">→</span></a>
                </>
              )}
              <ul class="plan__features">
                {p.features.map((f) => <li><span class="plan__tick" aria-hidden="true">✓</span>{f}</li>)}
              </ul>
              <span class="plan__guarantee">Garantia de 7 dias · devolução 100%</span>
            </article>
          ))}
        </div>

        <!-- Plano grátis para sempre (separado dos pagos) -->
        <article class="freeplan reveal br-only">
          <div class="freeplan__head">
            <span class="freeplan__tag">Grátis para sempre</span>
            <h3 class="freeplan__name">Plano Grátis</h3>
            <p class="freeplan__blurb">Quer só experimentar, sem cartão e sem prazo? Comece de graça e suba de plano quando quiser.</p>
          </div>
          <ul class="freeplan__features">
            <li><span class="plan__tick" aria-hidden="true">✓</span> Para sempre, sem cartão</li>
            <li><span class="plan__tick" aria-hidden="true">✓</span> Só Instagram (sem TikTok)</li>
            <li><span class="plan__tick" aria-hidden="true">✓</span> Até 200 envios automáticos por mês</li>
            <li><span class="plan__tick" aria-hidden="true">✓</span> Mensagens com marca d’água “⚡ Enviado com Notifiquei”</li>
          </ul>
          <div class="freeplan__cta">
            <a href={FREE} class="btn btn--ghost btn--lg">Começar grátis<span class="arr" aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>
    </section>


<script>
    // Toggle mensal/anual nos planos
    const toggle = document.getElementById("billtoggle");
    const grid = document.getElementById("plans-grid");
    if (toggle && grid) {
      toggle.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".billtoggle__opt");
        if (!btn) return;
        const annual = btn.dataset.cycle === "a";
        toggle.querySelectorAll(".billtoggle__opt").forEach((o) => {
          o.classList.toggle("is-on", o === btn);
          o.setAttribute("aria-pressed", String(o === btn));
        });
        // querySelectorAll, não querySelector: desde que o card virou multi-moeda,
        // cada um carrega 3 preços e 2 botões (Brasil + internacional). No singular,
        // o toggle só mexia no primeiro — o BRL, que fica escondido lá fora — e o
        // gringo via o preço travado no anual. Atualiza todos; o CSS mostra o certo.
        grid.querySelectorAll<HTMLElement>(".plan").forEach((card) => {
          card.querySelectorAll<HTMLElement>(".plan__amount").forEach((amt) => {
            amt.textContent = annual ? amt.dataset.a! : amt.dataset.m!;
          });
          card.querySelectorAll<HTMLElement>(".plan__bill").forEach((bill) => {
            bill.textContent = annual ? bill.dataset.bill! : "";
          });
          card.querySelectorAll<HTMLAnchorElement>(".plan__cta").forEach((cta) => {
            cta.href = annual ? cta.dataset.hrefA! : cta.dataset.hrefM!;
          });
        });
      });
    }

</script>
